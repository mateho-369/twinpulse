#ifndef TP_LOGGER_MQH
#define TP_LOGGER_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh

#define TP_LOG_MAX_BYTES  2097152     // 2 MB, then the log file is recycled

//+------------------------------------------------------------------+
//| TP_LogFileWrite - append one line to Common\Files\TwinPulse.log   |
//+------------------------------------------------------------------+
void TP_LogFileWrite(const string line)
  {
   if(!EnableFileLog) return;

   int handle = FileOpen(TP_LOG_FILE, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, 0, FILE_COMMON);
   bool created = (handle == INVALID_HANDLE);
   if(created)
      handle = FileOpen(TP_LOG_FILE, FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, 0, FILE_COMMON);
   if(handle == INVALID_HANDLE) return;

   if(created)
      FileWriteString(handle, "time,level,symbol,magic,message\n");

   if(FileSize(handle) > TP_LOG_MAX_BYTES)
     {
      FileClose((int)handle);
      FileDelete(TP_LOG_FILE, FILE_COMMON);
      handle = FileOpen(TP_LOG_FILE, FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, 0, FILE_COMMON);
      if(handle == INVALID_HANDLE) return;
      FileWriteString(handle, "time,level,symbol,magic,message\n");
     }

   FileSeek(handle, 0, SEEK_END);
   FileWriteString(handle, line + "\n");
   FileClose((int)handle);
  }

//+------------------------------------------------------------------+
//| TP_Log - central log function                                      |
//+------------------------------------------------------------------+
void TP_Log(const string level, const string message)
  {
   bool isInfo  = (level == "INFO");
   bool isWarn  = (level == "WARN");
   bool isError = (level == "ERROR");

   if(isInfo && !VerboseLog && !isWarn && !isError)
     {
      // info messages are only written to the file, not to the journal
      TP_LogFileWrite(StringFormat("%s,%s,%s,%d,%s",
                                   TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS),
                                   level, g_symbol, (int)g_magic, message));
      return;
     }

   string line = StringFormat("%s | %s | %s | %d | %s",
                              TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS),
                              level, g_symbol, (int)g_magic, message);
   Print(line);
   TP_LogFileWrite(StringFormat("%s,%s,%s,%d,%s",
                                TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS),
                                level, g_symbol, (int)g_magic, message));
  }

//+------------------------------------------------------------------+
//| convenience wrappers                                              |
//+------------------------------------------------------------------+
void TP_LogInfo(const string message)
  {
   TP_Log("INFO", message);
  }

void TP_LogWarn(const string message)
  {
   TP_Log("WARN", message);
  }

void TP_LogError(const string message)
  {
   TP_Log("ERROR", message);
  }

//+------------------------------------------------------------------+
//| TP_CsvAppend - append one line to a CSV file in Common\Files      |
//+------------------------------------------------------------------+
void TP_CsvAppend(const string fileName, const string header, const string line)
  {
   if(!WriteCsvLogs) return;

   int handle = FileOpen(fileName, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, 0, FILE_COMMON);
   bool created = (handle == INVALID_HANDLE);
   if(created)
      handle = FileOpen(fileName, FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, 0, FILE_COMMON);
   if(handle == INVALID_HANDLE) return;

   if(created)
      FileWriteString(handle, header + "\n");

   FileSeek(handle, 0, SEEK_END);
   FileWriteString(handle, line + "\n");
   FileClose((int)handle);
  }

//+------------------------------------------------------------------+
//| TP_LogLegCSV - one row for every closed leg                       |
//+------------------------------------------------------------------+
void TP_LogLegCSV(const int legIndex, const int cycleId, const double volume,
                  const double openPrice, const double closePrice, const double profit,
                  const string reason, const double bank, const string regime,
                  const double spread, const double atr5)
  {
   string line = StringFormat("%s,%d,%s,%s,%.2f,%s,%s,%s,%.2f,%.2f,%s,%.3f,%.3f",
                              TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS),
                              cycleId, TP_LegName(legIndex),
                              TP_LegIsBuy(legIndex) ? "BUY" : "SELL",
                              volume,
                              TP_Str(openPrice, 3), TP_Str(closePrice, 3),
                              reason, profit, bank, regime, spread, atr5);
   TP_CsvAppend(TP_LEGS_CSV,
                "time,cycle,leg,side,volume,open_price,close_price,reason,profit,bank,regime,spread,atr5",
                line);
  }

//+------------------------------------------------------------------+
//| TP_LogCycleCSV - one row for every finished cycle                  |
//+------------------------------------------------------------------+
void TP_LogCycleCSV(const int cycleId, const datetime startTime, const datetime endTime,
                    const string regime, const int legsOpened, const int legsClosed,
                    const double realized, const double bank, const double shredded,
                    const string reason, const double spread, const double atr5)
  {
   string line = StringFormat("%s,%d,%s,%s,%s,%d,%d,%.2f,%.2f,%.2f,%s,%.3f,%.3f",
                              TimeToString(endTime, TIME_DATE | TIME_SECONDS),
                              cycleId,
                              TimeToString(startTime, TIME_DATE | TIME_SECONDS),
                              TimeToString(endTime, TIME_DATE | TIME_SECONDS),
                              regime, legsOpened, legsClosed,
                              realized, bank, shredded, reason, spread, atr5);
   TP_CsvAppend(TP_CYCLES_CSV,
                "time,cycle_id,start_time,end_time,regime,legs_opened,legs_closed,realized,bank,shredded,reason,spread,atr5",
                line);
  }

#endif // TP_LOGGER_MQH
//+--- end MQL5/Include/TwinPulse/Logger.mqh ---------------------------
//+--- begin MQL5/Include/TwinPulse/State.mqh ----------------------------
//+------------------------------------------------------------------+
//|                                                  State.mqh        |
//|  TwinPulse Hedge EA                                                 |
//|  Runtime state of the EA plus rebuild from the open positions.     |
//+------------------------------------------------------------------+
#ifndef TP_STATE_MQH
#define TP_STATE_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh

//--- state of one leg of the current cycle ----------------------------
struct TpLegState
  {
   bool               used;         // leg belongs to the running cycle
   bool               open;         // position is open
   ulong              ticket;       // position ticket
   ulong              positionId;   // POSITION_IDENTIFIER
   ENUM_POSITION_TYPE type;
   double             volume;
   double             openPrice;
   double             sl;
   double             tp;
   double             profit;       // floating profit incl. swap
   datetime           openTime;
   int                generation;   // number of re-opens of this leg
   bool               beDone;       // break-even already applied
   double             peakPrice;    // best price seen, used for the trailing
   double             realized;     // realized money of this leg
   bool               wasOpen;      // previous snapshot, used to detect closes
   datetime           lastModify;   // last time the stop was moved
  };

//--- global EA state --------------------------------------------------
struct TpState
  {
   int       cycleId;
   datetime  cycleStart;
   int       cycleRegime;        // regime when the cycle was started
   int       regime;             // current regime
   double    bank;               // realized profit of the cycle not used yet
   double    cycleRealized;      // realized money of the cycle
   double    cycleShredded;      // money spent on shredding losers
   int       closedLegs;         // number of closed legs in this cycle
   int       openedLegs;         // number of opened legs in this cycle
   datetime  lastReopen;
   datetime  lastOpen;
   double    dayStartEquity;
   int       dayStamp;
   bool      dailyLocked;
   bool      basketLocked;
   double    peakEquity;
   double    atr5;               // ATR(14) on M5, price units
   double    atrM15;             // ATR(14) on M15, price units
   double    regimeEr;           // efficiency ratio M15
   double    regimeChop;         // choppiness index M15
   double    regimeAdx;          // ADX(14) M15
   double    regimeSlope;        // EMA50 slope on M15 in ATR units per SlopeBars
   double    regimeBbMid;        // Bollinger middle line M15
   double    regimeAtrMed;       // median of ATR5 over the last 100 bars
   bool      regimeAboveH1;      // price above the EMA50 on H1
   double    medianSpread;       // rolling median spread, price units
   double    spreadSamples[TP_SPREAD_SAMPLES];
   int       spreadCount;
   int       spreadHead;
   datetime  lastSpreadSample;
   datetime  lastM15Bar;
   bool      newsBlock;
   bool      tradeAllowed;       // trading is possible on this account
   string    blockReason;        // why trading is not possible
   TpLegState legs[TP_LEG_COUNT];
  };

//--- the single global state object ----------------------------------
TpState g_tp;

//+------------------------------------------------------------------+
//| TP_State_Init - reset the volatile state                          |
//+------------------------------------------------------------------+
void TP_State_Init(void)
  {
   g_tp.cycleId       = 0;
   g_tp.cycleStart    = 0;
   g_tp.cycleRegime   = TP_REG_NEUTRAL;
   g_tp.regime        = TP_REG_NEUTRAL;
   g_tp.bank          = 0.0;
   g_tp.cycleRealized = 0.0;
   g_tp.cycleShredded = 0.0;
   g_tp.closedLegs    = 0;
   g_tp.openedLegs    = 0;
   g_tp.lastReopen    = 0;
   g_tp.lastOpen      = 0;
   g_tp.dayStartEquity= 0.0;
   g_tp.dayStamp      = 0;
   g_tp.dailyLocked   = false;
   g_tp.basketLocked  = false;
   g_tp.peakEquity    = AccountInfoDouble(ACCOUNT_EQUITY);
   g_tp.atr5          = 0.0;
   g_tp.atrM15        = 0.0;
   g_tp.regimeEr      = 0.0;
   g_tp.regimeChop    = 0.0;
   g_tp.regimeAdx     = 0.0;
   g_tp.regimeSlope   = 0.0;
   g_tp.regimeBbMid   = 0.0;
   g_tp.regimeAtrMed  = 0.0;
   g_tp.regimeAboveH1 = false;
   g_tp.medianSpread  = 0.0;
   g_tp.spreadCount   = 0;
   g_tp.spreadHead    = 0;
   g_tp.lastSpreadSample = 0;
   g_tp.lastM15Bar    = 0;
   g_tp.newsBlock     = false;
   g_tp.tradeAllowed  = true;
   g_tp.blockReason   = "";

   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      g_tp.legs[i].used       = false;
      g_tp.legs[i].open       = false;
      g_tp.legs[i].ticket     = 0;
      g_tp.legs[i].positionId = 0;
      g_tp.legs[i].type       = POSITION_TYPE_BUY;
      g_tp.legs[i].volume     = 0.0;
      g_tp.legs[i].openPrice  = 0.0;
      g_tp.legs[i].sl         = 0.0;
      g_tp.legs[i].tp         = 0.0;
      g_tp.legs[i].profit     = 0.0;
      g_tp.legs[i].openTime   = 0;
      g_tp.legs[i].generation = 0;
      g_tp.legs[i].beDone     = false;
      g_tp.legs[i].peakPrice  = 0.0;
      g_tp.legs[i].realized   = 0.0;
      g_tp.legs[i].wasOpen    = false;
      g_tp.legs[i].lastModify = 0;
     }
  }

//+------------------------------------------------------------------+
//| TP_State_GlobalName - build the name of a global variable         |
//+------------------------------------------------------------------+
string TP_State_GlobalName(const string key)
  {
   return StringFormat("%s%s_%s_%d", TP_GV_PREFIX, key, g_symbol, (int)g_magic);
  }

//+------------------------------------------------------------------+
//| TP_State_Save - persist the state that must survive a restart     |
//+------------------------------------------------------------------+
void TP_State_Save(void)
  {
   GlobalVariableSet(TP_State_GlobalName("Cycle"),    (double)g_tp.cycleId);
   GlobalVariableSet(TP_State_GlobalName("CycleStart"),(double)g_tp.cycleStart);
   GlobalVariableSet(TP_State_GlobalName("Bank"),     g_tp.bank);
   GlobalVariableSet(TP_State_GlobalName("Realized"), g_tp.cycleRealized);
   GlobalVariableSet(TP_State_GlobalName("Shredded"), g_tp.cycleShredded);
   GlobalVariableSet(TP_State_GlobalName("Opened"),   (double)g_tp.openedLegs);
   GlobalVariableSet(TP_State_GlobalName("Closed"),   (double)g_tp.closedLegs);
   GlobalVariableSet(TP_State_GlobalName("DayEq"),    g_tp.dayStartEquity);
   GlobalVariableSet(TP_State_GlobalName("DayStamp"), (double)g_tp.dayStamp);
   GlobalVariableSet(TP_State_GlobalName("DayLock"),  g_tp.dailyLocked ? 1.0 : 0.0);
   GlobalVariableSet(TP_State_GlobalName("Basket"),   g_tp.basketLocked ? 1.0 : 0.0);
  }

//+------------------------------------------------------------------+
//| TP_State_Load - restore the persisted state                       |
//+------------------------------------------------------------------+
void TP_State_Load(void)
  {
   string k = TP_State_GlobalName("Cycle");
   if(GlobalVariableCheck(k))
      g_tp.cycleId = (int)GlobalVariableGet(k);

   k = TP_State_GlobalName("CycleStart");
   if(GlobalVariableCheck(k))
      g_tp.cycleStart = (datetime)GlobalVariableGet(k);

   k = TP_State_GlobalName("Bank");
   if(GlobalVariableCheck(k))
      g_tp.bank = GlobalVariableGet(k);

   k = TP_State_GlobalName("Realized");
   if(GlobalVariableCheck(k))
      g_tp.cycleRealized = GlobalVariableGet(k);

   k = TP_State_GlobalName("Shredded");
   if(GlobalVariableCheck(k))
      g_tp.cycleShredded = GlobalVariableGet(k);

   k = TP_State_GlobalName("Opened");
   if(GlobalVariableCheck(k))
      g_tp.openedLegs = (int)GlobalVariableGet(k);

   k = TP_State_GlobalName("Closed");
   if(GlobalVariableCheck(k))
      g_tp.closedLegs = (int)GlobalVariableGet(k);

   k = TP_State_GlobalName("DayEq");
   if(GlobalVariableCheck(k))
      g_tp.dayStartEquity = GlobalVariableGet(k);

   k = TP_State_GlobalName("DayStamp");
   if(GlobalVariableCheck(k))
      g_tp.dayStamp = (int)GlobalVariableGet(k);

   k = TP_State_GlobalName("DayLock");
   if(GlobalVariableCheck(k))
      g_tp.dailyLocked = (GlobalVariableGet(k) > 0.5);

   k = TP_State_GlobalName("Basket");
   if(GlobalVariableCheck(k))
      g_tp.basketLocked = (GlobalVariableGet(k) > 0.5);
  }

//+------------------------------------------------------------------+
//| TP_State_SyncPositions - rebuild the leg map from the open         |
//| positions of our symbol and magic. The comment carries the cycle   |
//| id and the leg name, so the state survives a terminal restart.    |
//+------------------------------------------------------------------+
void TP_State_SyncPositions(void)
  {
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      // the ticket, the position id, the volume and the open time are
      // kept so that a closed leg can still be logged
      g_tp.legs[i].open       = false;
      g_tp.legs[i].profit     = 0.0;
     }

   int total = PositionsTotal();
   for(int p = 0; p < total; p++)
     {
      ulong ticket = PositionGetTicket(p);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != g_symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC) != g_magic) continue;

      int cycleId = -1;
      int legIdx  = -1;
      if(!TP_ParseComment(PositionGetString(POSITION_COMMENT), cycleId, legIdx)) continue;
      if(legIdx < 0 || legIdx >= TP_LEG_COUNT) continue;

      g_tp.legs[legIdx].open       = true;
      g_tp.legs[legIdx].ticket     = ticket;
      g_tp.legs[legIdx].positionId = (ulong)PositionGetInteger(POSITION_IDENTIFIER);
      g_tp.legs[legIdx].type       = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      g_tp.legs[legIdx].volume     = PositionGetDouble(POSITION_VOLUME);
      g_tp.legs[legIdx].openPrice  = PositionGetDouble(POSITION_PRICE_OPEN);
      g_tp.legs[legIdx].sl         = PositionGetDouble(POSITION_SL);
      g_tp.legs[legIdx].tp         = PositionGetDouble(POSITION_TP);
      g_tp.legs[legIdx].profit     = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
      g_tp.legs[legIdx].openTime   = (datetime)PositionGetInteger(POSITION_TIME);
      g_tp.legs[legIdx].used       = true;
      if(cycleId > 0 && cycleId > g_tp.cycleId) g_tp.cycleId = cycleId;
     }
  }

//+------------------------------------------------------------------+
//| TP_State_CountOpenLegs - number of open legs of one side          |
//+------------------------------------------------------------------+
int TP_State_CountOpenLegs(const int side)
  {
   int n = 0;
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(!g_tp.legs[i].open) continue;
      bool isBuy = TP_LegIsBuy(i);
      if((side == TP_SIDE_BUY && isBuy) || (side == TP_SIDE_SELL && !isBuy)) n++;
     }
   return n;
  }

//+------------------------------------------------------------------+
//| TP_State_OpenVolume - total open volume of one side                |
//+------------------------------------------------------------------+
double TP_State_OpenVolume(const int side)
  {
   double v = 0.0;
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(!g_tp.legs[i].open) continue;
      bool isBuy = TP_LegIsBuy(i);
      if((side == TP_SIDE_BUY && isBuy) || (side == TP_SIDE_SELL && !isBuy)) v += g_tp.legs[i].volume;
     }
   return v;
  }

//+------------------------------------------------------------------+
//| TP_State_SideFloating - floating P/L of one side                  |
//+------------------------------------------------------------------+
double TP_State_SideFloating(const int side)
  {
   double p = 0.0;
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(!g_tp.legs[i].open) continue;
      bool isBuy = TP_LegIsBuy(i);
      if((side == TP_SIDE_BUY && isBuy) || (side == TP_SIDE_SELL && !isBuy)) p += g_tp.legs[i].profit;
     }
   return p;
  }

//+------------------------------------------------------------------+
//| TP_State_AllFloating - floating P/L of every open leg             |
//+------------------------------------------------------------------+
double TP_State_AllFloating(void)
  {
   double p = 0.0;
   for(int i = 0; i < TP_LEG_COUNT; i++)
      if(g_tp.legs[i].open) p += g_tp.legs[i].profit;
   return p;
  }

//+------------------------------------------------------------------+
//| TP_State_OpenLegCount - number of open legs in total              |
//+------------------------------------------------------------------+
int TP_State_OpenLegCount(void)
  {
   int n = 0;
   for(int i = 0; i < TP_LEG_COUNT; i++) if(g_tp.legs[i].open) n++;
   return n;
  }

//+------------------------------------------------------------------+
//| TP_State_TotalVolume - all open lots of this EA                   |
//+------------------------------------------------------------------+
double TP_State_TotalVolume(void)
  {
   double v = 0.0;
   for(int i = 0; i < TP_LEG_COUNT; i++) if(g_tp.legs[i].open) v += g_tp.legs[i].volume;
   return v;
  }

//+------------------------------------------------------------------+
//| TP_State_CycleTotal - realized + floating money of the cycle      |
//+------------------------------------------------------------------+
double TP_State_CycleTotal(void)
  {
   return g_tp.cycleRealized + TP_State_AllFloating();
  }

//+------------------------------------------------------------------+
//| TP_State_RealizedForPosition - money realised when a position was  |
//| closed. Sums profit, commission and swap of the exit deals.       |
//+------------------------------------------------------------------+
double TP_State_RealizedForPosition(const ulong positionId, const datetime fromTime, double &closePrice)
  {
   closePrice = 0.0;
   if(positionId == 0) return 0.0;

   datetime to = TimeCurrent() + 60;
   datetime from = fromTime - 1;
   if(from < 60) from = TimeCurrent() - 3600;

   double sum = 0.0;
   bool found = false;

   //--- the history can lag a tick behind a fresh order, retry a few times
   for(int attempt = 0; attempt < 3; attempt++)
     {
      if(attempt > 0) Sleep(30);
      if(!HistorySelect(from, to)) continue;

      sum = 0.0;
      closePrice = 0.0;
      found = false;
      int deals = HistoryDealsTotal();
      for(int i = 0; i < deals; i++)
        {
         ulong deal = HistoryDealGetTicket(i);
         if(deal == 0) continue;
         if((ulong)HistoryDealGetInteger(deal, DEAL_POSITION_ID) != positionId) continue;
         int entry = (int)HistoryDealGetInteger(deal, DEAL_ENTRY);
         if(entry != DEAL_ENTRY_OUT && entry != DEAL_ENTRY_OUT_BY) continue;
         sum  += HistoryDealGetDouble(deal, DEAL_PROFIT);
         sum  += HistoryDealGetDouble(deal, DEAL_COMMISSION);
         sum  += HistoryDealGetDouble(deal, DEAL_SWAP);
         closePrice = HistoryDealGetDouble(deal, DEAL_PRICE);
         found = true;
        }
      if(found) break;
     }

   return sum;
  }

#endif // TP_STATE_MQH
//+--- end MQL5/Include/TwinPulse/State.mqh ----------------------------
//+--- begin MQL5/Include/TwinPulse/News.mqh -----------------------------
//+------------------------------------------------------------------+
//|                                                   News.mqh        |
//|  TwinPulse Hedge EA                                                 |
//|  High impact USD news filter.                                      |
//|   * Live  : MQL5 economic calendar (CalendarValueHistory)          |
//|   * Tester: Common\Files\TwinPulse_news.csv written by the        |
//|             script TwinPulseNewsExport.mq5                        |
//+------------------------------------------------------------------+
#ifndef TP_NEWS_MQH
#define TP_NEWS_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh
// (already inlined) project header: Logger.mqh
// (already inlined) project header: State.mqh

//--- news cache -------------------------------------------------------
datetime g_newsTimes[];        // sorted event times (server time)
bool     g_newsLoaded    = false;
bool     g_newsCsvFound   = false;
bool     g_newsUseCalendar = false;
datetime g_newsLastRefresh = 0;
bool     g_newsWarned     = false;

//--- forward declaration ------------------------------------------------
bool TP_News_Blocked(const datetime t);

//+------------------------------------------------------------------+
//| TP_News_UTCOffsetSeconds - server clock offset versus UTC          |
//+------------------------------------------------------------------+
int TP_News_UTCOffsetSeconds(void)
  {
   return (int)MathRound(ServerUTCOffsetHours * 3600.0);
  }

//+------------------------------------------------------------------+
//| TP_News_UtcToServer - convert a UTC timestamp into server time     |
//+------------------------------------------------------------------+
datetime TP_News_UtcToServer(const datetime utcTime)
  {
   return utcTime - TP_News_UTCOffsetSeconds();
  }

//+------------------------------------------------------------------+
//| TP_News_LoadCsv - read the exported news file                       |
//+------------------------------------------------------------------+
bool TP_News_LoadCsv(void)
  {
   ArrayFree(g_newsTimes);
   g_newsLoaded    = false;
   g_newsCsvFound  = false;

   int handle = FileOpen(NewsCsvFile, FILE_READ | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, 0, FILE_COMMON);
   if(handle == INVALID_HANDLE)
     {
      if(!g_newsWarned)
        {
         g_newsWarned = true;
         TP_LogWarn(StringFormat("News file '%s' not found in Common\\Files - news filter disabled%s",
                                 NewsCsvFile,
                                 (MQLInfoInteger(MQL_TESTER) ? " (Strategy Tester)" : "")));
        }
      return false;
     }

   bool firstLine = true;
   int rows = 0;
   while(!FileIsEnding(handle))
     {
      string line = FileReadString(handle);
      if(StringLen(line) == 0) continue;
      if(firstLine) { firstLine = false; if(StringFind(line, "datetime") == 0) continue; }

      string fields[];
      int n = StringSplit(line, ',', fields);
      if(n < 3) continue;

      string dtStr = fields[0];
      string imp   = fields[1];
      string cur   = fields[2];
      StringTrimLeft(dtStr); StringTrimRight(dtStr);
      StringTrimLeft(imp);   StringTrimRight(imp);
      StringTrimLeft(cur);   StringTrimRight(cur);

      if(imp != "HIGH") continue;
      if(StringLen(cur) > 0 && cur != NewsCurrency) continue;

      datetime t = StringToTime(dtStr);
      if(t == 0) continue;

      int size = ArraySize(g_newsTimes);
      ArrayResize(g_newsTimes, size + 1);
      g_newsTimes[size] = t;
      rows++;
     }
   FileClose((int)handle);

   g_newsCsvFound = true;
   g_newsLoaded   = true;
   if(ArraySize(g_newsTimes) > 1) ArraySort(g_newsTimes);

   TP_LogInfo(StringFormat("News CSV '%s' loaded: %d high impact %s events",
                           NewsCsvFile, rows, NewsCurrency));
   return true;
  }

//+------------------------------------------------------------------+
//| TP_News_RefreshCalendar - read the live economic calendar          |
//+------------------------------------------------------------------+
bool TP_News_RefreshCalendar(void)
  {
   ArrayFree(g_newsTimes);
   g_newsLoaded = false;

   datetime from = TimeCurrent() - 6 * 3600;
   datetime to   = TimeCurrent() + 7 * 86400;

   MqlCalendarValue values[];
   int count = CalendarValueHistory(values, from, to, NULL, NewsCurrency);
   if(count <= 0) return false;

   for(int i = 0; i < count; i++)
     {
      MqlCalendarEvent ev;
      if(!CalendarEventById(values[i].event_id, ev)) continue;
      if((int)ev.importance != (int)CALENDAR_IMPORTANCE_HIGH) continue;

      int size = ArraySize(g_newsTimes);
      ArrayResize(g_newsTimes, size + 1);
      g_newsTimes[size] = TP_News_UtcToServer(values[i].time);
     }

   if(ArraySize(g_newsTimes) > 1) ArraySort(g_newsTimes);
   g_newsLoaded = true;
   return true;
  }

//+------------------------------------------------------------------+
//| TP_News_Init - prepare the news source for this run                |
//+------------------------------------------------------------------+
void TP_News_Init(void)
  {
   g_newsWarned     = false;
   g_newsLoaded     = false;
   g_newsCsvFound   = false;
   g_newsUseCalendar = false;
   g_newsLastRefresh = 0;

   if(!UseNewsFilter)
     {
      TP_LogInfo("News filter disabled by input.");
      return;
     }

   if(MQLInfoInteger(MQL_TESTER))
     {
      g_newsUseCalendar = false;
      TP_News_LoadCsv();
      if(!g_newsCsvFound)
         TP_LogWarn("Strategy Tester: no news file found, news filter is OFF for this run.");
      return;
     }

   g_newsUseCalendar = true;
   if(TP_News_RefreshCalendar())
      TP_LogInfo(StringFormat("Economic calendar loaded: %d high impact %s events.",
                              ArraySize(g_newsTimes), NewsCurrency));
   else
     {
      g_newsUseCalendar = false;
      TP_LogWarn("Economic calendar not available, falling back to the news CSV file.");
      TP_News_LoadCsv();
     }
  }

//+------------------------------------------------------------------+
//| TP_News_Update - refresh the source when needed                    |
//+------------------------------------------------------------------+
void TP_News_Update(void)
  {
   if(!UseNewsFilter) { g_tp.newsBlock = false; return; }

   if(g_newsUseCalendar)
     {
      if(g_newsLastRefresh == 0 || (TimeCurrent() - g_newsLastRefresh) >= 900)
        {
         g_newsLastRefresh = TimeCurrent();
         if(!TP_News_RefreshCalendar())
           {
            // keep the previous cache, only flag it
            g_tp.newsBlock = TP_News_Blocked(TimeCurrent());
            return;
           }
        }
     }
   else if(!g_newsLoaded && !g_newsCsvFound)
     {
      // try once more, the file may appear later
      TP_News_LoadCsv();
     }

   g_tp.newsBlock = TP_News_Blocked(TimeCurrent());
  }

//+------------------------------------------------------------------+
//| TP_News_Blocked - true when the given time is inside a block       |
//+------------------------------------------------------------------+
bool TP_News_Blocked(const datetime t)
  {
   if(!UseNewsFilter) return false;
   if(!g_newsLoaded) return false;
   if(ArraySize(g_newsTimes) == 0) return false;

   datetime from = t - NewsMinutesBefore * 60;
   datetime to   = t + NewsMinutesAfter * 60;

   int lo = 0;
   int hi = ArraySize(g_newsTimes) - 1;
   while(lo <= hi)
     {
      int mid = (lo + hi) / 2;
      datetime ev = g_newsTimes[mid];
      if(ev < from)      { lo = mid + 1; }
      else if(ev > to)   { hi = mid - 1; }
      else               return true;
     }
   return false;
  }

//+------------------------------------------------------------------+
//| TP_News_Status - short status string for the panel                 |
//+------------------------------------------------------------------+
string TP_News_Status(void)
  {
   if(!UseNewsFilter) return "OFF";
   if(!g_newsLoaded)  return "NO DATA";
   if(g_tp.newsBlock) return "BLOCKED";
   return "CLEAR";
  }

#endif // TP_NEWS_MQH
//+--- end MQL5/Include/TwinPulse/News.mqh -----------------------------
//+--- begin MQL5/Include/TwinPulse/Execution.mqh ------------------------
//+------------------------------------------------------------------+
//|                                                Execution.mqh      |
//|  TwinPulse Hedge EA                                                 |
//|  All order handling: market entries, closes, Close By, partial     |
//|  closes and stop modifications.  Every order is checked with       |
//|  OrderCheck and sent with bounded retries.                         |
//+------------------------------------------------------------------+
#ifndef TP_EXECUTION_MQH
#define TP_EXECUTION_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh
// (already inlined) project header: Logger.mqh
// (already inlined) project header: State.mqh

//+------------------------------------------------------------------+
//| TP_Exec_FillingMode - filling mode accepted by the broker         |
//+------------------------------------------------------------------+
ENUM_ORDER_TYPE_FILLING TP_Exec_FillingMode(void)
  {
   int filling = (int)SymbolInfoInteger(g_symbol, SYMBOL_FILLING_MODE);
   if((filling & SYMBOL_FILLING_FOK) == SYMBOL_FILLING_FOK)
      return ORDER_FILLING_FOK;
   if((filling & SYMBOL_FILLING_IOC) == SYMBOL_FILLING_IOC)
      return ORDER_FILLING_IOC;
   // ORDER_FILLING_RETURN is the documented fallback when the symbol
   // exposes neither of the market filling flags.
   return ORDER_FILLING_RETURN;
  }

//+------------------------------------------------------------------+
//| TP_Exec_CurrentSpreadPrice - current spread in price units        |
//+------------------------------------------------------------------+
double TP_Exec_CurrentSpreadPrice(void)
  {
   MqlTick tick;
   if(SymbolInfoTick(g_symbol, tick) && tick.ask > 0.0 && tick.bid > 0.0)
      return (tick.ask - tick.bid);

   double points = (double)SymbolInfoInteger(g_symbol, SYMBOL_SPREAD);
   if(points <= 0.0) return 0.0;
   return points * g_point;
  }

//+------------------------------------------------------------------+
//| TP_Exec_NormalizePrice - round a price to the symbol digits       |
//+------------------------------------------------------------------+
double TP_Exec_NormalizePrice(const double price)
  {
   return NormalizeDouble(price, g_digits);
  }

//+------------------------------------------------------------------+
//| TP_Exec_StopDistance - minimum allowed stop distance in price     |
//+------------------------------------------------------------------+
double TP_Exec_StopDistance(void)
  {
   long stops = SymbolInfoInteger(g_symbol, SYMBOL_TRADE_STOPS_LEVEL);
   double d = (double)stops * g_point;
   if(d < 2.0 * g_point) d = 2.0 * g_point;
   return d;
  }

//+------------------------------------------------------------------+
//| TP_Exec_Retriable - the retcode allows a retry with a new price   |
//+------------------------------------------------------------------+
bool TP_Exec_Retriable(const uint retcode)
  {
   if(retcode == TRADE_RETCODE_REQUOTE)           return true;
   if(retcode == TRADE_RETCODE_REJECT)            return true;
   if(retcode == TRADE_RETCODE_PRICE_CHANGED)     return true;
   if(retcode == TRADE_RETCODE_PRICE_OFF)         return true;
   if(retcode == TRADE_RETCODE_TOO_MANY_REQUESTS) return true;
   if(retcode == TRADE_RETCODE_TIMEOUT)           return true;
   return false;
  }

//+------------------------------------------------------------------+
//| TP_Exec_Fatal - the retcode means we must stop trading             |
//+------------------------------------------------------------------+
bool TP_Exec_Fatal(const uint retcode)
  {
   if(retcode == TRADE_RETCODE_NO_MONEY)       return true;
   if(retcode == TRADE_RETCODE_MARKET_CLOSED)  return true;
   if(retcode == TRADE_RETCODE_TRADE_DISABLED) return true;
   if(retcode == TRADE_RETCODE_INVALID)        return true;
   if(retcode == TRADE_RETCODE_INVALID_VOLUME) return true;
   if(retcode == TRADE_RETCODE_INVALID_PRICE)  return true;
   if(retcode == TRADE_RETCODE_INVALID_STOPS)  return true;
   if(retcode == TRADE_RETCODE_LIMIT_VOLUME)   return true;
   if(retcode == TRADE_RETCODE_LIMIT_POSITIONS) return true;
   if(retcode == TRADE_RETCODE_SERVER_DISABLES_AT) return true;
   if(retcode == TRADE_RETCODE_CLIENT_DISABLES_AT) return true;
   if(retcode == TRADE_RETCODE_ONLY_REAL)      return true;
   return false;
  }

//+------------------------------------------------------------------+
//| TP_Exec_SendRequest - OrderCheck + OrderSend with retries         |
//+------------------------------------------------------------------+
bool TP_Exec_SendRequest(MqlTradeRequest &request, MqlTradeResult &result, const string what)
  {
   int attempts = MaxOrderRetries;
   if(attempts < 1) attempts = 1;
   if(attempts > 10) attempts = 10;

   for(int attempt = 1; attempt <= attempts; attempt++)
     {
      MqlTradeCheckResult check;
      ZeroMemory(check);
      if(!OrderCheck(request, check) || check.retcode != 0)
        {
         uint chk = check.retcode;
         if(chk == 0) chk = (uint)GetLastError();
         if(!TP_Exec_Retriable(chk))
           {
            TP_LogError(StringFormat("%s failed in OrderCheck, code %u", what, chk));
            return false;
           }
        }

      if(!g_trade.OrderSend(request, result))
        {
         uint rc = g_trade.ResultRetcode();
         if(!TP_Exec_Retriable(rc))
           {
            TP_LogError(StringFormat("%s failed: %u (%s)", what, rc, g_trade.ResultRetcodeDescription()));
            return false;
           }
        }
      else
        {
         uint rc = result.retcode;
         if(rc == 0 || rc == TRADE_RETCODE_DONE || rc == TRADE_RETCODE_DONE_PARTIAL || rc == TRADE_RETCODE_PLACED)
            return true;

         if(rc == TRADE_RETCODE_INVALID_FILL)
           {
            // retry with the next filling mode
            if(request.type_filling == ORDER_FILLING_FOK)
               request.type_filling = ORDER_FILLING_IOC;
            else if(request.type_filling == ORDER_FILLING_IOC)
               request.type_filling = ORDER_FILLING_RETURN;
            else
              {
               TP_LogError(StringFormat("%s: fill required and no alternative filling mode.", what));
               return false;
              }
            continue;
           }

         if(TP_Exec_Retriable(rc))
           {
            Sleep(100);
            continue;
           }

         TP_LogError(StringFormat("%s failed: %u (%s)", what, rc, g_trade.ResultRetcodeDescription()));
         return false;
        }

      Sleep(150);
     }

   TP_LogError(StringFormat("%s failed after %d attempts.", what, attempts));
   return false;
  }

//+------------------------------------------------------------------+
//| TP_Exec_FreeMarginOk - enough free margin for an extra order       |
//+------------------------------------------------------------------+
bool TP_Exec_FreeMarginOk(const ENUM_ORDER_TYPE orderType, const double volume, const double price)
  {
   double margin = 0.0;
   if(!OrderCalcMargin(orderType, g_symbol, volume, price, margin))
     {
      TP_LogWarn("OrderCalcMargin failed, the order is not sent.");
      return false;
     }
   double free = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   if(margin > free)
     {
      TP_LogWarn(StringFormat("Not enough free margin: need %.2f, free %.2f.", margin, free));
      return false;
     }
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Exec_OpenLeg - open one leg of a cycle                          |
//+------------------------------------------------------------------+
bool TP_Exec_OpenLeg(const int legIndex, const double volume, const double sl, const double tp, const int cycleId)
  {
   MqlTick tick;
   if(!SymbolInfoTick(g_symbol, tick))
     {
      TP_LogError("SymbolInfoTick failed, cannot open a leg.");
      return false;
     }

   bool isBuy = TP_LegIsBuy(legIndex);
   double price = isBuy ? tick.ask : tick.bid;
   price = TP_Exec_NormalizePrice(price);

   //--- stops must respect the minimum stop distance ------------------
   double minDist = TP_Exec_StopDistance();
   double slPrice = TP_Exec_NormalizePrice(sl);
   if(isBuy)
     {
      if(price - slPrice < minDist) slPrice = TP_Exec_NormalizePrice(price - minDist);
     }
   else
     {
      if(slPrice - price < minDist) slPrice = TP_Exec_NormalizePrice(price + minDist);
     }

   MqlTradeRequest request;
   MqlTradeResult  result;
   ZeroMemory(request);
   ZeroMemory(result);

   request.action       = TRADE_ACTION_DEAL;
   request.symbol       = g_symbol;
   request.magic        = (ulong)g_magic;
   request.volume       = volume;
   request.type         = isBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   request.price        = price;
   request.deviation    = DeviationPoints;
   request.comment      = TP_MakeComment(cycleId, legIndex);
   request.type_filling = TP_Exec_FillingMode();
   request.type_time    = ORDER_TIME_GTC;

   if(slPrice > 0.0) request.sl = slPrice;
   if(tp > 0.0)      request.tp = TP_Exec_NormalizePrice(tp);

   //--- a position must never be opened without a stop loss ---------
   if(slPrice <= 0.0)
     {
      if(g_tp.atr5 <= 0.0)
        {
         TP_LogError("No ATR available, the leg is not opened without a stop loss.");
         return false;
        }
      double dist = HardSL_ATR * g_tp.atr5;
      if(dist < minDist) dist = minDist;
      slPrice = TP_Exec_NormalizePrice(isBuy ? (price - dist) : (price + dist));
      request.sl = slPrice;
     }

   if(!TP_Exec_FreeMarginOk(request.type, volume, price))
      return false;

   string what = StringFormat("open %s %.2f lots", TP_LegName(legIndex), volume);
   if(!TP_Exec_SendRequest(request, result, what))
      return false;

   TP_LogInfo(StringFormat("%s OK: %s %.2f @ %s (deal %I64u)",
                           what, isBuy ? "BUY" : "SELL", volume,
                           TP_Str(price, g_digits), result.deal));
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Exec_CloseLeg - close a full position                           |
//+------------------------------------------------------------------+
bool TP_Exec_CloseLeg(const ulong ticket)
  {
   if(ticket == 0) return false;
   if(!g_trade.PositionClose(ticket))
     {
      uint rc = g_trade.ResultRetcode();
      TP_LogWarn(StringFormat("Close of ticket %I64u failed: %u (%s)", ticket, rc,
                              g_trade.ResultRetcodeDescription()));
      return false;
     }
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Exec_CloseBy - close two opposite positions against each other  |
//+------------------------------------------------------------------+
bool TP_Exec_CloseBy(const ulong ticket1, const ulong ticket2)
  {
   if(ticket1 == 0 || ticket2 == 0 || ticket1 == ticket2) return false;
   if(!g_trade.PositionCloseBy(ticket1, ticket2))
     {
      uint rc = g_trade.ResultRetcode();
      TP_LogWarn(StringFormat("Close By %I64u / %I64u failed: %u (%s)", ticket1, ticket2, rc,
                              g_trade.ResultRetcodeDescription()));
      return false;
     }
   TP_LogInfo(StringFormat("Close By executed: %I64u / %I64u", ticket1, ticket2));
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Exec_PartialClose - close a part of a position                  |
//+------------------------------------------------------------------+
bool TP_Exec_PartialClose(const ulong ticket, const double volume)
  {
   if(ticket == 0 || volume <= 0.0) return false;
   if(!g_trade.PositionClosePartial(ticket, volume))
     {
      uint rc = g_trade.ResultRetcode();
      TP_LogWarn(StringFormat("Partial close of %I64u (%.2f) failed: %u (%s)", ticket, volume, rc,
                              g_trade.ResultRetcodeDescription()));
      return false;
     }
   TP_LogInfo(StringFormat("Partial close: ticket %I64u volume %.2f", ticket, volume));
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Exec_ModifySL - change the stop loss (and optionally the TP)   |
//|  The stop is never moved further away from the market.             |
//+------------------------------------------------------------------+
bool TP_Exec_ModifySL(const ulong ticket, const double newSl, const double newTp)
  {
   if(ticket == 0) return false;
   if(!g_pos.SelectByTicket(ticket))
      return false;

   double curSl = g_pos.StopLoss();
   double curTp = g_pos.TakeProfit();
   bool isBuy = (g_pos.PositionType() == POSITION_TYPE_BUY);

   double sl = TP_Exec_NormalizePrice(newSl);
   double tp = TP_Exec_NormalizePrice(newTp);

   //--- never widen a stop -------------------------------------------
   if(curSl > 0.0)
     {
      if(isBuy && sl > 0.0 && sl < curSl) sl = curSl;
      if(!isBuy && sl > 0.0 && sl > curSl) sl = curSl;
     }

   //--- never change a stop into something invalid -------------------
   if(sl > 0.0 && MathAbs(sl - curSl) < g_point && MathAbs(tp - curTp) < g_point)
      return true;    // nothing to do

   MqlTradeRequest request;
   MqlTradeResult  result;
   ZeroMemory(request);
   ZeroMemory(result);

   request.action     = TRADE_ACTION_SLTP;
   request.symbol     = g_symbol;
   request.position   = ticket;
   request.magic      = (ulong)g_magic;
   request.sl         = sl;
   request.tp         = tp;
   request.deviation  = DeviationPoints;
   request.type_filling = TP_Exec_FillingMode();
   request.type_time  = ORDER_TIME_GTC;

   if(!g_trade.OrderSend(request, result))
     {
      uint rc = g_trade.ResultRetcode();
      if(rc == TRADE_RETCODE_NO_CHANGES) return true;
      if(TP_Exec_Retriable(rc))
        {
         Sleep(100);
         if(!g_trade.OrderSend(request, result))
           {
            rc = g_trade.ResultRetcode();
            TP_LogWarn(StringFormat("SL modify of %I64u failed: %u (%s)", ticket, rc,
                                    g_trade.ResultRetcodeDescription()));
            return false;
           }
         return true;
        }
      TP_LogWarn(StringFormat("SL modify of %I64u failed: %u (%s)", ticket, rc,
                              g_trade.ResultRetcodeDescription()));
      return false;
     }

   if(result.retcode != 0 && result.retcode != TRADE_RETCODE_DONE)
     {
      if(result.retcode == TRADE_RETCODE_NO_CHANGES) return true;
      TP_LogWarn(StringFormat("SL modify of %I64u: %u (%s)", ticket, result.retcode,
                              g_trade.ResultRetcodeDescription()));
      return false;
     }
   return true;
  }

#endif // TP_EXECUTION_MQH
//+--- end MQL5/Include/TwinPulse/Execution.mqh ------------------------
//+--- begin MQL5/Include/TwinPulse/Risk.mqh -----------------------------
//+------------------------------------------------------------------+
//|                                                   Risk.mqh        |
//|  TwinPulse Hedge EA                                                 |
//|  Brakes, session filters, spread control and margin checks.        |
//+------------------------------------------------------------------+
#ifndef TP_RISK_MQH
#define TP_RISK_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh
// (already inlined) project header: Logger.mqh
// (already inlined) project header: State.mqh
// (already inlined) project header: Execution.mqh

//+------------------------------------------------------------------+
//| TP_Risk_InitSpreadSamples - warm up the rolling median spread     |
//| from the tick history of the last 10 minutes.                      |
//+------------------------------------------------------------------+
void TP_Risk_InitSpreadSamples(void)
  {
   g_tp.spreadCount = 0;
   g_tp.spreadHead  = 0;

   datetime from = TimeCurrent() - 600;
   MqlTick ticks[];
   int got = CopyTicksRange(g_symbol, ticks, COPY_TICKS_ALL,
                            (ulong)from * 1000, (ulong)TimeCurrent() * 1000);
   if(got > 0)
     {
      int step = got / 100;
      if(step < 1) step = 1;
      for(int i = 0; i < got; i += step)
        {
         if(ticks[i].ask <= 0.0 || ticks[i].bid <= 0.0) continue;
         double sp = ticks[i].ask - ticks[i].bid;
         if(sp <= 0.0) continue;
         g_tp.spreadSamples[g_tp.spreadHead] = sp;
         g_tp.spreadHead = (g_tp.spreadHead + 1) % TP_SPREAD_SAMPLES;
         if(g_tp.spreadCount < TP_SPREAD_SAMPLES) g_tp.spreadCount++;
        }
     }

   if(g_tp.spreadCount == 0)
     {
      double s = TP_Exec_CurrentSpreadPrice();
      if(s > 0.0)
        {
         g_tp.spreadSamples[0] = s;
         g_tp.spreadHead = 1;
         g_tp.spreadCount = 1;
        }
     }

   double tmp[];
   ArrayResize(tmp, g_tp.spreadCount);
   for(int i = 0; i < g_tp.spreadCount; i++) tmp[i] = g_tp.spreadSamples[i];
   g_tp.medianSpread = TP_Median(tmp);

   TP_LogInfo(StringFormat("Rolling median spread initialised: %.3f (%d samples)",
                           g_tp.medianSpread, g_tp.spreadCount));
  }

//+------------------------------------------------------------------+
//| TP_Risk_UpdateSpreadSample - add one spread sample and refresh    |
//| the rolling median.                                                |
//+------------------------------------------------------------------+
void TP_Risk_UpdateSpreadSample(void)
  {
   datetime now = TimeCurrent();
   if(g_tp.lastSpreadSample != 0 && (now - g_tp.lastSpreadSample) < SpreadSampleSec)
      return;
   g_tp.lastSpreadSample = now;

   double spread = TP_Exec_CurrentSpreadPrice();
   if(spread <= 0.0) return;

   g_tp.spreadSamples[g_tp.spreadHead] = spread;
   g_tp.spreadHead = (g_tp.spreadHead + 1) % TP_SPREAD_SAMPLES;
   if(g_tp.spreadCount < TP_SPREAD_SAMPLES) g_tp.spreadCount++;

   double tmp[];
   ArrayResize(tmp, g_tp.spreadCount);
   for(int i = 0; i < g_tp.spreadCount; i++) tmp[i] = g_tp.spreadSamples[i];
   g_tp.medianSpread = TP_Median(tmp);
  }

//+------------------------------------------------------------------+
//| TP_Risk_MaxSpreadPrice - effective maximum spread for new orders  |
//+------------------------------------------------------------------+
double TP_Risk_MaxSpreadPrice(void)
  {
   double limit = MaxSpreadPrice;
   if(g_tp.medianSpread > 0.0)
     {
      double mult = SpreadMedianMult * g_tp.medianSpread;
      if(mult < limit) limit = mult;
     }
   return limit;
  }

//+------------------------------------------------------------------+
//| TP_Risk_SpreadOK - is the current spread small enough?            |
//+------------------------------------------------------------------+
bool TP_Risk_SpreadOK(void)
  {
   double spread = TP_Exec_CurrentSpreadPrice();
   double limit  = TP_Risk_MaxSpreadPrice();
   if(limit <= 0.0) return true;
   return (spread <= limit);
  }

//+------------------------------------------------------------------+
//| TP_Risk_SessionFilter - pure time filter, used by the self test   |
//+------------------------------------------------------------------+
bool TP_Risk_SessionFilter(const datetime t,
                           const int sessionStart, const int sessionEnd,
                           const int rolloverStart, const int rolloverEnd,
                           const int fridayStop, const bool newCycle)
  {
   if(TP_IsWeekend(t)) return false;

   int hour = TP_ServerHour(t);
   if(hour >= rolloverStart && hour < rolloverEnd) return false;

   if(newCycle)
     {
      if(hour < sessionStart || hour >= sessionEnd) return false;
      if(TP_IsFriday(t) && hour >= fridayStop) return false;
     }
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Risk_SessionOK - time based filters                            |
//|  newCycle = true for a brand new cycle, false for a re-open.      |
//+------------------------------------------------------------------+
bool TP_Risk_SessionOK(const datetime t, const bool newCycle)
  {
   return TP_Risk_SessionFilter(t, SessionStartHour, SessionEndHour,
                                RolloverStartHour, RolloverEndHour,
                                FridayStopHour, newCycle);
  }

//+------------------------------------------------------------------+
//| TP_Risk_MarginLevelOK - margin level must stay above the limit   |
//+------------------------------------------------------------------+
bool TP_Risk_MarginLevelOK(void)
  {
   double level = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
   if(level <= 0.0) return true;              // no margin used
   return (level >= MinMarginLevelPct);
  }

//+------------------------------------------------------------------+
//| TP_Risk_VolumeOK - the total volume must stay below the cap      |
//+------------------------------------------------------------------+
bool TP_Risk_VolumeOK(const double extraVolume)
  {
   double total = TP_State_TotalVolume() + extraVolume;
   if(total > MaxTotalLots + 1e-8)
     {
      TP_LogWarn(StringFormat("MaxTotalLots reached: %.2f of %.2f lots.", total, MaxTotalLots));
      return false;
     }
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Risk_AllowsOpen - consolidated brake check for a new position  |
//+------------------------------------------------------------------+
bool TP_Risk_AllowsOpen(const double volume, string &reason)
  {
   reason = "";

   if(!g_tp.tradeAllowed) { reason = g_tp.blockReason; return false; }
   if(g_tp.dailyLocked)  { reason = "daily loss stop"; return false; }
   if(g_tp.basketLocked) { reason = "basket stop"; return false; }
   if(!TP_Risk_SpreadOK()) { reason = "spread too high"; return false; }
   if(!TP_Risk_MarginLevelOK()) { reason = "margin level too low"; return false; }
   if(!TP_Risk_VolumeOK(volume)) { reason = "max total lots"; return false; }
   if(RiskMode == TP_RISK_OFF) { reason = "RiskMode OFF"; return false; }
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Risk_UpdateDayEquity - roll the daily baseline over            |
//+------------------------------------------------------------------+
void TP_Risk_UpdateDayEquity(void)
  {
   int stamp = TP_DayStamp(TimeCurrent());
   if(stamp == g_tp.dayStamp) return;

   g_tp.dayStamp       = stamp;
   g_tp.dayStartEquity = AccountInfoDouble(ACCOUNT_EQUITY);
   g_tp.dailyLocked    = false;
   TP_State_Save();
   TP_LogInfo(StringFormat("New server day %d, start of day equity %.2f",
                           stamp, g_tp.dayStartEquity));
  }

//+------------------------------------------------------------------+
//| TP_Risk_BasketStopHit - the cycle lost too much                    |
//+------------------------------------------------------------------+
bool TP_Risk_BasketStopHit(void)
  {
   if(TP_State_OpenLegCount() == 0) return false;
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   if(equity <= 0.0) return false;
   double limit = -(equity * BasketStopPct / 100.0);
   return (TP_State_CycleTotal() <= limit);
  }

//+------------------------------------------------------------------+
//| TP_Risk_DailyStopHit - the account lost too much today             |
//+------------------------------------------------------------------+
bool TP_Risk_DailyStopHit(void)
  {
   if(g_tp.dayStartEquity <= 0.0) return false;
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   double limit  = g_tp.dayStartEquity * (1.0 - DailyStopPct / 100.0);
   return (equity <= limit);
  }

//+------------------------------------------------------------------+
//| TP_Risk_LegAgeMinutes - age of a leg in minutes                    |
//+------------------------------------------------------------------+
int TP_Risk_LegAgeMinutes(const int legIndex)
  {
   if(legIndex < 0 || legIndex >= TP_LEG_COUNT) return 0;
   if(!g_tp.legs[legIndex].open) return 0;
   if(g_tp.legs[legIndex].openTime <= 0) return 0;
   return (int)((TimeCurrent() - g_tp.legs[legIndex].openTime) / 60);
  }

//+------------------------------------------------------------------+
//| TP_Risk_SwapEstimate - expected nightly swap cost of the book     |
//+------------------------------------------------------------------+
double TP_Risk_SwapEstimate(void)
  {
   double swapLong  = SymbolInfoDouble(g_symbol, SYMBOL_SWAP_LONG);
   double swapShort = SymbolInfoDouble(g_symbol, SYMBOL_SWAP_SHORT);
   double total = 0.0;
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(!g_tp.legs[i].open) continue;
      double s = TP_LegIsBuy(i) ? swapLong : swapShort;
      total += MathAbs(s * g_tp.legs[i].volume);
     }
   return total;
  }

//+------------------------------------------------------------------+
//| TP_Risk_SwapModeText - short description of the swap mode         |
//+------------------------------------------------------------------+
string TP_Risk_SwapModeText(void)
  {
   int mode = (int)SymbolInfoInteger(g_symbol, SYMBOL_SWAP_MODE);
   if(mode == 0) return "points";
   if(mode == 1) return "currency";
   return "interest";
  }

#endif // TP_RISK_MQH
//+--- end MQL5/Include/TwinPulse/Risk.mqh -----------------------------
//+--- begin MQL5/Include/TwinPulse/Regime.mqh ---------------------------
//+------------------------------------------------------------------+
//|                                                Regime.mqh         |
//|  TwinPulse Hedge EA                                                 |
//|  Deterministic market regime detection, evaluated on closed M15    |
//|  bars.  The pure classifier is unit tested by TwinPulseSelfTest.   |
//+------------------------------------------------------------------+
#ifndef TP_REGIME_MQH
#define TP_REGIME_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh
// (already inlined) project header: Logger.mqh
// (already inlined) project header: State.mqh
// (already inlined) project header: Execution.mqh
// (already inlined) project header: Risk.mqh

//--- indicator handles -------------------------------------------------
int g_hAtr5    = INVALID_HANDLE;   // ATR(14) M5
int g_hAtrM15  = INVALID_HANDLE;   // ATR(14) M15
int g_hAdx     = INVALID_HANDLE;   // ADX(14) M15
int g_hBands   = INVALID_HANDLE;   // Bollinger(20,2) M15
int g_hEmaM15  = INVALID_HANDLE;   // EMA50 M15
int g_hEmaH1   = INVALID_HANDLE;   // EMA50 H1

//--- forward declarations ---------------------------------------------
void TP_Regime_Update(void);
int  TP_Regime_Get(void);
string TP_RegimeName(const int regime);
int  TP_ClassifyRegime(const double er, const double chop, const double adx,
                       const double slopeAtr, const bool priceAboveH1,
                       const bool atrSpike, const bool newsBlock, const bool spreadHot,
                       const double erRange, const double chopRange, const double adxRange,
                       const double erTrend, const double adxTrend);

//+------------------------------------------------------------------+
//| TP_BufValue - value of an indicator buffer, offset counted back    |
//| from the last copied element (0 = newest).                         |
//+------------------------------------------------------------------+
double TP_BufValue(const double &buf[], const int count, const int offset)
  {
   if(count <= 0) return 0.0;
   if(offset < 0) return 0.0;
   if(offset >= count) return 0.0;
   return buf[count - 1 - offset];
  }

//+------------------------------------------------------------------+
//| TP_Regime_HandlesReady - wait until the indicators are calculated  |
//+------------------------------------------------------------------+
bool TP_Regime_HandlesReady(void)
  {
   int handles[6];
   handles[0] = g_hAtr5;
   handles[1] = g_hAtrM15;
   handles[2] = g_hAdx;
   handles[3] = g_hBands;
   handles[4] = g_hEmaM15;
   handles[5] = g_hEmaH1;

   for(int pass = 0; pass < 30; pass++)
     {
      bool ready = true;
      for(int i = 0; i < 6; i++)
        {
         if(handles[i] == INVALID_HANDLE) { ready = false; break; }
         if(BarsCalculated(handles[i]) < 0) { ready = false; break; }
        }
      if(ready) return true;
      Sleep(200);
     }
   return false;
  }

//+------------------------------------------------------------------+
//| TP_Regime_Init - create every indicator handle                     |
//+------------------------------------------------------------------+
bool TP_Regime_Init(void)
  {
   g_hAtr5   = iATR(g_symbol, PERIOD_M5, 14);
   g_hAtrM15 = iATR(g_symbol, PERIOD_M15, 14);
   g_hAdx    = iADX(g_symbol, PERIOD_M15, 14);
   g_hBands  = iBands(g_symbol, PERIOD_M15, (int)BBPeriod, 0.0, BBDev, PRICE_CLOSE);
   g_hEmaM15 = iMA(g_symbol, PERIOD_M15, 50, 0, MODE_EMA, PRICE_CLOSE);
   g_hEmaH1  = iMA(g_symbol, PERIOD_H1, 50, 0, MODE_EMA, PRICE_CLOSE);

   if(g_hAtr5 == INVALID_HANDLE || g_hAtrM15 == INVALID_HANDLE || g_hAdx == INVALID_HANDLE ||
      g_hBands == INVALID_HANDLE || g_hEmaM15 == INVALID_HANDLE || g_hEmaH1 == INVALID_HANDLE)
     {
      TP_LogError(StringFormat("Indicator handle creation failed (error %d).", GetLastError()));
      return false;
     }

   if(!TP_Regime_HandlesReady())
      TP_LogWarn("The indicators are not calculated yet, the regime detection starts with the first bars.");

   return true;
  }

//+------------------------------------------------------------------+
//| TP_Regime_Release - release the indicator handles                  |
//+------------------------------------------------------------------+
void TP_Regime_Release(void)
  {
   if(g_hAtr5   != INVALID_HANDLE) { IndicatorRelease(g_hAtr5);   g_hAtr5   = INVALID_HANDLE; }
   if(g_hAtrM15 != INVALID_HANDLE) { IndicatorRelease(g_hAtrM15); g_hAtrM15 = INVALID_HANDLE; }
   if(g_hAdx    != INVALID_HANDLE) { IndicatorRelease(g_hAdx);    g_hAdx    = INVALID_HANDLE; }
   if(g_hBands  != INVALID_HANDLE) { IndicatorRelease(g_hBands);  g_hBands  = INVALID_HANDLE; }
   if(g_hEmaM15 != INVALID_HANDLE) { IndicatorRelease(g_hEmaM15); g_hEmaM15 = INVALID_HANDLE; }
   if(g_hEmaH1  != INVALID_HANDLE) { IndicatorRelease(g_hEmaH1);  g_hEmaH1  = INVALID_HANDLE; }
  }

//+------------------------------------------------------------------+
//| TP_ClassifyRegime - pure regime classifier                         |
//|                                                                   |
//|  CHAOS  : ATR spike, spread spike or inside a news block           |
//|  RANGE  : CHOP > chopRange and ER < erRange and ADX < adxRange     |
//|  TREND  : (ER > erTrend or ADX > adxTrend) and the EMA50 slope    |
//|           agrees with the price versus the EMA50 on H1             |
//|  NEUTRAL: everything else                                          |
//+------------------------------------------------------------------+
int TP_ClassifyRegime(const double er, const double chop, const double adx,
                      const double slopeAtr, const bool priceAboveH1,
                      const bool atrSpike, const bool newsBlock, const bool spreadHot,
                      const double erRange, const double chopRange, const double adxRange,
                      const double erTrend, const double adxTrend)
  {
   if(atrSpike || newsBlock || spreadHot)
      return TP_REG_CHAOS;

   if(chop > chopRange && er < erRange && adx < adxRange)
      return TP_REG_RANGE;

   if((er > erTrend) || (adx > adxTrend))
     {
      if(slopeAtr > 0.0 && priceAboveH1)  return TP_REG_TREND_UP;
      if(slopeAtr < 0.0 && !priceAboveH1) return TP_REG_TREND_DOWN;
     }

   return TP_REG_NEUTRAL;
  }

//+------------------------------------------------------------------+
//| TP_RegimeName - readable regime name                              |
//+------------------------------------------------------------------+
string TP_RegimeName(const int regime)
  {
   switch(regime)
     {
      case TP_REG_RANGE:      return "RANGE";
      case TP_REG_TREND_UP:   return "TREND_UP";
      case TP_REG_TREND_DOWN: return "TREND_DOWN";
      case TP_REG_NEUTRAL:    return "NEUTRAL";
      case TP_REG_CHAOS:      return "CHAOS";
     }
   return "UNKNOWN";
  }

//+------------------------------------------------------------------+
//| TP_Regime_Get - current regime                                    |
//+------------------------------------------------------------------+
int TP_Regime_Get(void) { return g_tp.regime; }

//+------------------------------------------------------------------+
//| TP_Regime_UpdateAtr - refresh ATR5 and its rolling median          |
//|  Called on every new M5 bar.                                       |
//+------------------------------------------------------------------+
void TP_Regime_UpdateAtr(void)
  {
   if(g_hAtr5 == INVALID_HANDLE) return;

   //--- ATR on M5 (closed bar) ---------------------------------------
   double atr5buf[];
   ArraySetAsSeries(atr5buf, false);
   int atrCount = CopyBuffer(g_hAtr5, 0, 1, 3, atr5buf);
   if(atrCount < 3)
      g_tp.atr5 = 0.0;
   else
      g_tp.atr5 = TP_BufValue(atr5buf, atrCount, 0);

   //--- median ATR5 over the last 100 closed bars --------------------
   double atrHist[];
   ArraySetAsSeries(atrHist, false);
   int histCount = CopyBuffer(g_hAtr5, 0, 1, 100, atrHist);
   if(histCount > 1)
     {
      double tmp[];
      ArrayResize(tmp, histCount);
      for(int i = 0; i < histCount; i++) tmp[i] = atrHist[i];
      g_tp.regimeAtrMed = TP_Median(tmp);
     }
   else
      g_tp.regimeAtrMed = g_tp.atr5;
  }

//+------------------------------------------------------------------+
//| TP_Regime_Update - recompute the regime from closed M15 bars       |
//+------------------------------------------------------------------+
void TP_Regime_Update(void)
  {
   if(g_hAtr5 == INVALID_HANDLE || g_hAtrM15 == INVALID_HANDLE || g_hAdx == INVALID_HANDLE ||
      g_hBands == INVALID_HANDLE || g_hEmaM15 == INVALID_HANDLE || g_hEmaH1 == INVALID_HANDLE)
      return;

   TP_Regime_UpdateAtr();

   //--- ATR on M15 ----------------------------------------------------
   double atrM15buf[];
   ArraySetAsSeries(atrM15buf, false);
   int atrM15Count = CopyBuffer(g_hAtrM15, 0, 1, 3, atrM15buf);
   g_tp.atrM15 = (atrM15Count >= 3) ? TP_BufValue(atrM15buf, atrM15Count, 0) : 0.0;

   //--- ADX on M15 ----------------------------------------------------
   double adxbuf[];
   ArraySetAsSeries(adxbuf, false);
   int adxCount = CopyBuffer(g_hAdx, 0, 1, 3, adxbuf);
   g_tp.regimeAdx = (adxCount >= 3) ? TP_BufValue(adxbuf, adxCount, 0) : 0.0;

   //--- EMA50 on M15 and its slope over SlopeBars --------------------
   double emaBuf[];
   ArraySetAsSeries(emaBuf, false);
   int emaCount = CopyBuffer(g_hEmaM15, 0, 1, SlopeBars + 2, emaBuf);
   double slope = 0.0;
   if(emaCount >= SlopeBars + 1)
     {
      double emaNow  = TP_BufValue(emaBuf, emaCount, 0);
      double emaPrev = TP_BufValue(emaBuf, emaCount, SlopeBars);
      slope = (emaNow - emaPrev) / TP_SafeDiv(g_tp.atrM15, 1.0, 0.0);
     }
   g_tp.regimeSlope = slope;

   //--- EMA50 on H1 and the price relation ----------------------------
   double emaH1buf[];
   ArraySetAsSeries(emaH1buf, false);
   int emaH1Count = CopyBuffer(g_hEmaH1, 0, 1, 2, emaH1buf);
   double emaH1 = (emaH1Count >= 2) ? TP_BufValue(emaH1buf, emaH1Count, 0) : 0.0;

   //--- M15 close and the Bollinger middle line -----------------------
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int need = RegimeERPeriod + 3;
   if(SlopeBars + 2 > need) need = SlopeBars + 2;
   int rateCount = CopyRates(g_symbol, PERIOD_M15, 1, need, rates);
   if(rateCount < 5)
     {
      TP_LogWarn("Not enough M15 history for the regime detection yet.");
      return;
     }

   double lastClose = rates[0].close;
   g_tp.regimeAboveH1 = (emaH1 > 0.0) ? (lastClose > emaH1) : (lastClose > 0.0);

   double bbBuf[];
   ArraySetAsSeries(bbBuf, false);
   int bbCount = CopyBuffer(g_hBands, 0, 1, 2, bbBuf);
   g_tp.regimeBbMid = (bbCount >= 2) ? TP_BufValue(bbBuf, bbCount, 0) : 0.0;

   //--- efficiency ratio and choppiness on chronological arrays -------
   int win = RegimeERPeriod + 1;
   if(win > rateCount) win = rateCount;
   if(win < 5) return;

   double closes[];
   double highs[];
   double lows[];
   ArrayResize(closes, win);
   ArrayResize(highs, win);
   ArrayResize(lows, win);
   for(int i = 0; i < win; i++)
     {
      closes[win - 1 - i] = rates[i].close;
      highs[win - 1 - i]  = rates[i].high;
      lows[win - 1 - i]   = rates[i].low;
     }

   g_tp.regimeEr   = TP_ComputeER(closes, win, RegimeERPeriod);
   g_tp.regimeChop = TP_ComputeCHOP(highs, lows, closes, win, RegimeERPeriod);

   //--- chaos conditions ----------------------------------------------
   bool atrSpike = false;
   if(g_tp.regimeAtrMed > 0.0 && g_tp.atr5 > 0.0)
      atrSpike = (g_tp.atr5 / g_tp.regimeAtrMed) > AtrSpikeRatio;

   bool spreadHot = false;
   double maxSpread = TP_Risk_MaxSpreadPrice();
   double spread = TP_Exec_CurrentSpreadPrice();
   if(maxSpread > 0.0 && spread > maxSpread) spreadHot = true;

   int regime = TP_ClassifyRegime(g_tp.regimeEr, g_tp.regimeChop, g_tp.regimeAdx,
                                   g_tp.regimeSlope, g_tp.regimeAboveH1,
                                   atrSpike, g_tp.newsBlock, spreadHot,
                                   ErRange, ChopRange, AdxRange, ErTrend, AdxTrend);

   if(regime != g_tp.regime)
     {
      TP_LogInfo(StringFormat("Regime change: %s -> %s (ER %.3f, CHOP %.1f, ADX %.1f, slope %.2f)",
                               TP_RegimeName(g_tp.regime), TP_RegimeName(regime),
                               g_tp.regimeEr, g_tp.regimeChop, g_tp.regimeAdx, g_tp.regimeSlope));
     }
   g_tp.regime = regime;
  }

#endif // TP_REGIME_MQH
//+--- end MQL5/Include/TwinPulse/Regime.mqh ---------------------------
//+--- begin MQL5/Include/TwinPulse/Bank.mqh -----------------------------
//+------------------------------------------------------------------+
//|                                                   Bank.mqh        |
//|  TwinPulse Hedge EA                                                 |
//|  Profit bank and loss shredding.                                   |
//|                                                                   |
//|  Bank  : realised money of the running cycle that is not used up  |
//|  Shred : use the bank to remove one volume step of the oldest     |
//|          losing leg, so the counter trend leg dies with a small   |
//|          controlled loss instead of running into the hard stop.    |
//+------------------------------------------------------------------+
#ifndef TP_BANK_MQH
#define TP_BANK_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh
// (already inlined) project header: Logger.mqh
// (already inlined) project header: State.mqh
// (already inlined) project header: Execution.mqh

//+------------------------------------------------------------------+
//| TP_Bank_ShredCost - bank needed to shred one step                 |
//|  (the loss of the step plus the cost of the spread)                |
//+------------------------------------------------------------------+
double TP_Bank_ShredCost(const double lossOfStep, const double spreadCost)
  {
   return MathAbs(lossOfStep) + MathAbs(spreadCost);
  }

//+------------------------------------------------------------------+
//| TP_Bank_CanShred - pure test, is the bank big enough?              |
//+------------------------------------------------------------------+
bool TP_Bank_CanShred(const double bank, const double lossOfStep, const double spreadCost)
  {
   if(bank <= 0.0) return false;
   return (bank >= TP_Bank_ShredCost(lossOfStep, spreadCost));
  }

//+------------------------------------------------------------------+
//| TP_Bank_AfterShred - bank remaining after the shred                |
//+------------------------------------------------------------------+
double TP_Bank_AfterShred(const double bank, const double lossOfStep, const double spreadCost)
  {
   return bank - TP_Bank_ShredCost(lossOfStep, spreadCost);
  }

//+------------------------------------------------------------------+
//| TP_Bank_Add - add realised money to the bank and to the cycle     |
//+------------------------------------------------------------------+
void TP_Bank_Add(const double amount)
  {
   g_tp.bank          += amount;
   g_tp.cycleRealized += amount;
  }

//+------------------------------------------------------------------+
//| TP_Bank_FindOldestLoser - index of the oldest losing open leg      |
//+------------------------------------------------------------------+
bool TP_Bank_FindOldestLoser(int &legIndex)
  {
   legIndex = -1;
   datetime oldest = 0;
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(!g_tp.legs[i].open) continue;
      if(g_tp.legs[i].profit >= 0.0) continue;
      if(legIndex < 0 || g_tp.legs[i].openTime < oldest)
        {
         legIndex = i;
         oldest   = g_tp.legs[i].openTime;
        }
     }
   return (legIndex >= 0);
  }

//+------------------------------------------------------------------+
//| TP_Bank_TryShred - close one volume step of the oldest loser      |
//|  when the bank covers it.                                          |
//+------------------------------------------------------------------+
bool TP_Bank_TryShred(void)
  {
   if(!TP_UseBank()) return false;
   if(g_tp.bank <= 0.0) return false;

   int leg = -1;
   if(!TP_Bank_FindOldestLoser(leg)) return false;

   double vol    = g_tp.legs[leg].volume;
   double spread = TP_Exec_CurrentSpreadPrice();
   if(vol <= 0.0) return false;

   double vmin = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_MIN);
   double step = ShredStepLot;
   if(step <= 0.0) step = 0.01;
   if(step > vol) step = vol;

   double lossOfStep = MathAbs(g_tp.legs[leg].profit) * (step / vol);
   double spreadCost = TP_PriceToMoney(g_symbol, step, spread);

   //--- would the rest of the leg become too small? -------------------
   double rest = vol - step;
   if(rest < vmin - 1e-8)
     {
      double fullLoss    = MathAbs(g_tp.legs[leg].profit);
      double fullSpread  = TP_PriceToMoney(g_symbol, vol, spread);
      if(!TP_Bank_CanShred(g_tp.bank, fullLoss, fullSpread))
        {
         TP_LogInfo(StringFormat("Shred skipped on %s: bank %.2f does not cover the full leg loss %.2f",
                                 TP_LegName(leg), g_tp.bank, TP_Bank_ShredCost(fullLoss, fullSpread)));
         return false;
        }
     }
   else if(!TP_Bank_CanShred(g_tp.bank, lossOfStep, spreadCost))
      return false;

   //--- perform the shred --------------------------------------------
   ulong  ticket   = g_tp.legs[leg].ticket;
   ulong  positionId = g_tp.legs[leg].positionId;
   double bankBefore = g_tp.bank;
   datetime started = TimeCurrent();

   bool ok = false;
   if(rest < vmin - 1e-8)
     {
      TP_LogInfo(StringFormat("Shredding the whole leg %s (%.2f lots), the rest would be below the minimum volume.",
                              TP_LegName(leg), vol));
      ok = TP_Exec_CloseLeg(ticket);
     }
   else
     {
      TP_LogInfo(StringFormat("Shredding %.2f lots of %s, loss %.2f, bank %.2f",
                              step, TP_LegName(leg), lossOfStep, bankBefore));
      ok = TP_Exec_PartialClose(ticket, step);
     }
   if(!ok) return false;

   double closePrice = 0.0;
   double realised   = TP_State_RealizedForPosition(positionId, started, closePrice);
   TP_Bank_Add(realised);
   g_tp.legs[leg].realized += realised;
   g_tp.cycleShredded += MathMax(0.0, -realised);

   TP_LogInfo(StringFormat("Shred done on %s: realised %.2f, bank %.2f -> %.2f, shredded total %.2f",
                           TP_LegName(leg), realised, bankBefore, g_tp.bank, g_tp.cycleShredded));
   TP_State_Save();
   return true;
  }

#endif // TP_BANK_MQH
//+--- end MQL5/Include/TwinPulse/Bank.mqh -----------------------------
//+--- begin MQL5/Include/TwinPulse/Legs.mqh -----------------------------
//+------------------------------------------------------------------+
//|                                                   Legs.mqh        |
//|  TwinPulse Hedge EA                                                 |
//|  The heart of the EA: the four legs of a cycle, their targets,     |
//|  the re-balance rule of the owner and the cycle level exits.       |
//+------------------------------------------------------------------+
#ifndef TP_LEGS_MQH
#define TP_LEGS_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh
// (already inlined) project header: Logger.mqh
// (already inlined) project header: State.mqh
// (already inlined) project header: Execution.mqh
// (already inlined) project header: Risk.mqh
// (already inlined) project header: Regime.mqh
// (already inlined) project header: Bank.mqh

//--- forward declarations ---------------------------------------------
void TP_Legs_Update(void);
void TP_Legs_TryStartCycle(void);
void TP_Legs_TryRebalance(void);
void TP_Legs_CloseCycle(const string reason);
double TP_Legs_TargetDistance(const int legIndex);
bool   TP_Legs_RebalanceCondition(const bool sideMissing, const double survivorPnl, const double tolerance);

//+------------------------------------------------------------------+
//| TP_Legs_CostFloorOf - pure cost floor calculation                  |
//+------------------------------------------------------------------+
double TP_Legs_CostFloorOf(const double spread, const double point)
  {
   double floorDist = CostFloorSpreadMult * spread;
   if(floorDist < 3.0 * point) floorDist = 3.0 * point;
   return floorDist;
  }

//+------------------------------------------------------------------+
//| TP_Legs_CostFloor - minimal target distance imposed by the costs  |
//+------------------------------------------------------------------+
double TP_Legs_CostFloor(void)
  {
   return TP_Legs_CostFloorOf(TP_Exec_CurrentSpreadPrice(), g_point);
  }

//+------------------------------------------------------------------+
//| TP_Legs_TargetDistanceOf - pure target distance calculation       |
//|  Leg A : TargetA_ATR x ATR5, Leg B : TargetB_ATR x ATR5            |
//|  Both are lifted to at least the cost floor.                       |
//+------------------------------------------------------------------+
double TP_Legs_TargetDistanceOf(const double atr, const double spread, const double point, const bool isLegA)
  {
   if(atr <= 0.0) return 0.0;
   double dist = isLegA ? (TargetA_ATR * atr) : (TargetB_ATR * atr);
   double floorDist = TP_Legs_CostFloorOf(spread, point);
   if(dist < floorDist) dist = floorDist;
   return dist;
  }

//+------------------------------------------------------------------+
//| TP_Legs_TargetDistance - target distance of a leg in price units   |
//+------------------------------------------------------------------+
double TP_Legs_TargetDistance(const int legIndex)
  {
   double atr = g_tp.atr5;
   if(atr <= 0.0) atr = g_tp.atrM15;
   if(atr <= 0.0) return 0.0;

   bool isLegA = (TP_LegSlot(legIndex) == 0);
   return TP_Legs_TargetDistanceOf(atr, TP_Exec_CurrentSpreadPrice(), g_point, isLegA);
  }

//+------------------------------------------------------------------+
//| TP_Legs_StopDistance - hard stop distance of a leg in price units  |
//+------------------------------------------------------------------+
double TP_Legs_StopDistance(void)
  {
   double atr = g_tp.atr5;
   if(atr <= 0.0) atr = g_tp.atrM15;
   if(atr <= 0.0) return 0.0;

   double dist = HardSL_ATR * atr;
   double minDist = TP_Exec_StopDistance();
   if(dist < minDist) dist = minDist;
   return dist;
  }

//+------------------------------------------------------------------+
//| TP_Legs_ProfitDistance - how far the price moved in our favour    |
//+------------------------------------------------------------------+
double TP_Legs_ProfitDistance(const int legIndex)
  {
   if(!g_tp.legs[legIndex].open) return 0.0;

   MqlTick tick;
   if(!SymbolInfoTick(g_symbol, tick)) return 0.0;

   if(TP_LegIsBuy(legIndex))
      return (tick.bid - g_tp.legs[legIndex].openPrice);
   return (g_tp.legs[legIndex].openPrice - tick.ask);
  }

//+------------------------------------------------------------------+
//| TP_Legs_RebalanceCondition - pure re-balance test                 |
//|  The surviving side must be back at (or above) the tolerance.      |
//+------------------------------------------------------------------+
bool TP_Legs_RebalanceCondition(const bool sideMissing, const double survivorPnl, const double tolerance)
  {
   if(!sideMissing) return false;
   return (survivorPnl >= -MathAbs(tolerance));
  }

//+------------------------------------------------------------------+
//| TP_Legs_ReopenReference - the P/L that decides a re-open          |
//|  The surviving legs of the opposite side are the reference.        |
//+------------------------------------------------------------------+
double TP_Legs_ReopenReference(const int legIndex, double &refVolume)
  {
   int side = TP_LegIsBuy(legIndex) ? TP_SIDE_BUY : TP_SIDE_SELL;
   int opp  = (side == TP_SIDE_BUY) ? TP_SIDE_SELL : TP_SIDE_BUY;

   refVolume = 0.0;
   double oppVol = TP_State_OpenVolume(opp);
   if(oppVol > 0.0)
     {
      refVolume = oppVol;
      return TP_State_SideFloating(opp);
     }

   double sameVol = TP_State_OpenVolume(side);
   if(sameVol > 0.0)
     {
      refVolume = sameVol;
      return TP_State_SideFloating(side);
     }

   refVolume = TP_State_TotalVolume();
   return TP_State_AllFloating();
  }

//+------------------------------------------------------------------+
//| TP_Legs_ReopenAllowed - all conditions for a re-open               |
//+------------------------------------------------------------------+
bool TP_Legs_ReopenAllowed(const int legIndex, string &reason)
  {
   reason = "";

   //--- regime ------------------------------------------------------
   if(TP_UseRegime())
     {
      int regime = g_tp.regime;
      if(regime == TP_REG_CHAOS) { reason = "regime CHAOS"; return false; }
      if(regime == TP_REG_NEUTRAL) { reason = "regime NEUTRAL"; return false; }
      if((regime == TP_REG_TREND_UP || regime == TP_REG_TREND_DOWN))
        {
         bool up = (regime == TP_REG_TREND_UP);
         bool legBuy = TP_LegIsBuy(legIndex);
         if(TP_IsOneSide())
           {
            if(legBuy != up) { reason = "counter trend side in ONE_SIDE"; return false; }
           }
         else
           {
            // in a trend only the with-trend side is re-opened
            if(legBuy != up) { reason = "counter trend side"; return false; }
           }
        }
     }

   //--- session, spread, brakes -------------------------------------
   if(!TP_Risk_SessionOK(TimeCurrent(), false)) { reason = "session filter"; return false; }
   if(!TP_Risk_SpreadOK()) { reason = "spread too high"; return false; }
   if(g_tp.dailyLocked) { reason = "daily loss stop"; return false; }
   if(g_tp.basketLocked) { reason = "basket stop"; return false; }
   if(!TP_Risk_MarginLevelOK()) { reason = "margin level too low"; return false; }

   //--- cooldown -----------------------------------------------------
   if(g_tp.lastReopen > 0 && (TimeCurrent() - g_tp.lastReopen) < ReopenCooldownSec)
     { reason = "cooldown"; return false; }

   //--- the surviving side must be at break even ---------------------
   double refVolume = 0.0;
   double refPnl = TP_Legs_ReopenReference(legIndex, refVolume);
   double tol = TP_ScaledUSD(RebalanceTolUSD, refVolume);
   if(!TP_Legs_RebalanceCondition(true, refPnl, tol))
     { reason = StringFormat("survivor P/L %.2f below tolerance %.2f", refPnl, tol); return false; }

   //--- and the mirror leg of the same slot must be at break even ----
   int mirror = TP_LegMirror(legIndex);
   if(g_tp.legs[mirror].open)
     {
      double mtol = TP_ScaledUSD(RebalanceTolUSD, g_tp.legs[mirror].volume);
      if(g_tp.legs[mirror].profit < -mtol)
        { reason = StringFormat("mirror %s P/L %.2f below tolerance %.2f",
                                TP_LegName(mirror), g_tp.legs[mirror].profit, mtol); return false; }
     }

   return true;
  }

//+------------------------------------------------------------------+
//| TP_Legs_LotFor - volume of a leg                                   |
//+------------------------------------------------------------------+
double TP_Legs_LotFor(const int legIndex)
  {
   double vmin   = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_MIN);
   double vmax   = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_MAX);
   double vstep  = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_STEP);
   double vlimit = SymbolInfoDouble(g_symbol, SYMBOL_VOLUME_LIMIT);

   double lot = BaseLot;

   if(RiskMode == TP_RISK_PERCENT)
     {
      double equity  = AccountInfoDouble(ACCOUNT_EQUITY);
      double slDist  = TP_Legs_StopDistance();
      double perLot  = TP_TickMoneyPerUnit(g_symbol, 1.0);
      double riskUSD = equity * LegRiskPct / 100.0;
      if(slDist > 0.0 && perLot > 0.0)
         lot = TP_SafeDiv(riskUSD, slDist * perLot, BaseLot);
      else
         lot = BaseLot;
     }
   else
     {
      double mult = TP_EffectiveLotMultiplier();
      int gen = g_tp.legs[legIndex].generation;
      if(gen < 0) gen = 0;
      if(gen > 5) gen = 5;
      lot = BaseLot * MathPow(mult, gen);
     }

   return TP_NormalizeVolume(lot, vmin, vmax, vstep, vlimit);
  }

//+------------------------------------------------------------------+
//| TP_Legs_OpenOne - open one leg of the cycle                       |
//+------------------------------------------------------------------+
bool TP_Legs_OpenOne(const int legIndex, const bool isReopen)
  {
   double lot = TP_Legs_LotFor(legIndex);

   string reason = "";
   if(!TP_Risk_AllowsOpen(lot, reason))
     {
      TP_LogInfo(StringFormat("%s not opened: %s", TP_LegName(legIndex), reason));
      return false;
     }

   MqlTick tick;
   if(!SymbolInfoTick(g_symbol, tick)) return false;

   bool isBuy = TP_LegIsBuy(legIndex);
   double price = isBuy ? tick.ask : tick.bid;
   double stopDist = TP_Legs_StopDistance();
   if(stopDist <= 0.0)
     {
      TP_LogWarn(StringFormat("%s not opened: no ATR for the stop loss.", TP_LegName(legIndex)));
      return false;
     }

   double sl = isBuy ? (price - stopDist) : (price + stopDist);
   sl = TP_Exec_NormalizePrice(sl);

   if(!TP_Exec_OpenLeg(legIndex, lot, sl, 0.0, g_tp.cycleId))
      return false;

   g_tp.openedLegs++;
   if(isReopen)
     {
      g_tp.legs[legIndex].generation++;
      g_tp.lastReopen = TimeCurrent();
     }
   else
      g_tp.lastOpen = TimeCurrent();

   g_tp.legs[legIndex].used = true;
   return true;
  }

//+------------------------------------------------------------------+
//| TP_Legs_RegisterClose - book the realised money of a closed leg   |
//+------------------------------------------------------------------+
void TP_Legs_RegisterClose(const int legIndex, const string reason, const double closePrice)
  {
   ulong posId = g_tp.legs[legIndex].positionId;
   double price = closePrice;
   double cumulative = TP_State_RealizedForPosition(posId, g_tp.legs[legIndex].openTime, price);
   double delta = cumulative - g_tp.legs[legIndex].realized;
   g_tp.legs[legIndex].realized = cumulative;
   TP_Bank_Add(delta);

   g_tp.closedLegs++;
   g_tp.legs[legIndex].wasOpen = false;

   TP_LogLegCSV(legIndex, g_tp.cycleId, g_tp.legs[legIndex].volume,
                g_tp.legs[legIndex].openPrice, price, delta, reason,
                g_tp.bank, TP_RegimeName(g_tp.regime),
                TP_Exec_CurrentSpreadPrice(), g_tp.atr5);
  }

//+------------------------------------------------------------------+
//| TP_Legs_DetectClosedLegs - find legs that disappeared between two |
//| synchronisations (stop loss, take profit or a manual close) and   |
//| book their realised money.                                        |
//+------------------------------------------------------------------+
void TP_Legs_DetectClosedLegs(void)
  {
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(g_tp.legs[i].wasOpen && !g_tp.legs[i].open)
        {
         TP_LogInfo(StringFormat("%s was closed by the server.", TP_LegName(i)));
         TP_Legs_RegisterClose(i, "server_close", 0.0);
        }
      g_tp.legs[i].wasOpen = g_tp.legs[i].open;
     }
  }

//+------------------------------------------------------------------+
//| TP_Legs_CloseWinner - close a leg that reached its target          |
//|  When the opposite leg of the same slot shows a positive combined |
//|  result the pair is closed with Close By, that saves one spread.   |
//+------------------------------------------------------------------+
void TP_Legs_CloseWinner(const int legIndex)
  {
   int mirror = TP_LegMirror(legIndex);
   ulong ticket = g_tp.legs[legIndex].ticket;

   if(g_tp.legs[mirror].open)
     {
      double v1 = g_tp.legs[legIndex].volume;
      double v2 = g_tp.legs[mirror].volume;
      double combined = g_tp.legs[legIndex].profit + g_tp.legs[mirror].profit;
      double need = TP_ScaledUSD(MinBankUSD, v1);

      if(MathAbs(v1 - v2) < 1e-8 && combined >= need)
        {
         TP_LogInfo(StringFormat("Close By: %s and %s, combined %.2f >= %.2f",
                                 TP_LegName(legIndex), TP_LegName(mirror), combined, need));
         if(TP_Exec_CloseBy(ticket, g_tp.legs[mirror].ticket))
           {
            TP_Legs_RegisterClose(legIndex, "closeby_winner", 0.0);
            TP_Legs_RegisterClose(mirror, "closeby_loser", 0.0);
            return;
           }
         TP_LogWarn("Close By failed, the winner is closed alone.");
        }
     }

   if(TP_Exec_CloseLeg(ticket))
      TP_Legs_RegisterClose(legIndex, "target", 0.0);
  }

//+------------------------------------------------------------------+
//| TP_Legs_ManageRunner - break even and trailing of the leg B        |
//+------------------------------------------------------------------+
void TP_Legs_ManageRunner(const int legIndex)
  {
   if(!g_tp.legs[legIndex].open) return;

   bool isBuy = TP_LegIsBuy(legIndex);
   double atr = g_tp.atr5;
   if(atr <= 0.0) return;

   MqlTick tick;
   if(!SymbolInfoTick(g_symbol, tick)) return;

   double entry = g_tp.legs[legIndex].openPrice;
   double spread = TP_Exec_CurrentSpreadPrice();

   //--- track the best price -----------------------------------------
   double best = g_tp.legs[legIndex].peakPrice;
   if(best <= 0.0) best = isBuy ? tick.bid : tick.ask;
   if(isBuy)
     {
      if(tick.bid > best) best = tick.bid;
     }
   else
     {
      if(tick.ask < best) best = tick.ask;
     }
   g_tp.legs[legIndex].peakPrice = best;

   double newSl = g_tp.legs[legIndex].sl;
   double currentSl = g_tp.legs[legIndex].sl;

   //--- break even ----------------------------------------------------
   double beDist = BE_ATR * atr;
   double moved = isBuy ? (tick.bid - entry) : (entry - tick.ask);
   if(!g_tp.legs[legIndex].beDone && moved >= beDist)
     {
      double beSl = isBuy ? (entry + spread) : (entry - spread);
      if(currentSl <= 0.0 || (isBuy && beSl > currentSl) || (!isBuy && (beSl < currentSl || currentSl <= 0.0)))
        {
         newSl = TP_Exec_NormalizePrice(beSl);
         g_tp.legs[legIndex].beDone = true;
         TP_LogInfo(StringFormat("%s: break even stop moved to %s", TP_LegName(legIndex),
                                 TP_Str(newSl, g_digits)));
        }
     }

   //--- trailing ------------------------------------------------------
   double trailDist = Trail_ATR * atr;
   double trailSl = isBuy ? (best - trailDist) : (best + trailDist);
   if(g_tp.legs[legIndex].beDone)
     {
      if(currentSl <= 0.0 || (isBuy && trailSl > currentSl) || (!isBuy && trailSl < currentSl))
         newSl = TP_Exec_NormalizePrice(trailSl);
     }

   if(newSl <= 0.0) return;
   if(currentSl > 0.0)
     {
      if(isBuy && newSl <= currentSl) return;      // never widen
      if(!isBuy && newSl >= currentSl) return;
     }

   //--- throttle: at most one stop modification every two seconds ----
   if(g_tp.legs[legIndex].lastModify > 0 &&
      (TimeCurrent() - g_tp.legs[legIndex].lastModify) < 2)
      return;

   if(TP_Exec_ModifySL(g_tp.legs[legIndex].ticket, newSl, g_tp.legs[legIndex].tp))
     {
      g_tp.legs[legIndex].sl = newSl;
      g_tp.legs[legIndex].lastModify = TimeCurrent();
     }
  }

//+------------------------------------------------------------------+
//| TP_Legs_Update - per tick management of the open legs              |
//+------------------------------------------------------------------+
void TP_Legs_Update(void)
  {
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(!g_tp.legs[i].open) continue;

      //--- time stop --------------------------------------------------
      int age = TP_Risk_LegAgeMinutes(i);
      if(age > MaxLoserMinutes && g_tp.legs[i].profit < 0.0)
        {
         if(!TP_Bank_TryShred())
           {
            TP_LogInfo(StringFormat("Time stop: %s is %.0f minutes old, closing it.", TP_LegName(i), age));
            if(TP_Exec_CloseLeg(g_tp.legs[i].ticket))
               TP_Legs_RegisterClose(i, "time_stop", 0.0);
           }
         continue;
        }

      //--- target ------------------------------------------------------
      double target = TP_Legs_TargetDistance(i);
      if(target > 0.0)
        {
         double moved = TP_Legs_ProfitDistance(i);
         if(moved >= target)
           {
            TP_LogInfo(StringFormat("%s reached its target (%.3f of %.3f), profit %.2f",
                                    TP_LegName(i), moved, target, g_tp.legs[i].profit));
            TP_Legs_CloseWinner(i);
            continue;
           }
        }

      //--- runner management -----------------------------------------
      if(TP_LegSlot(i) == 1)
         TP_Legs_ManageRunner(i);
     }
  }

//+------------------------------------------------------------------+
//| TP_Legs_TryStartCycle - open a new cycle of four legs              |
//+------------------------------------------------------------------+
void TP_Legs_TryStartCycle(void)
  {
   if(TP_State_OpenLegCount() > 0) return;
   if(g_tp.dailyLocked || g_tp.basketLocked) return;
   if(!g_tp.tradeAllowed) return;
   if(RiskMode == TP_RISK_OFF) return;

   if(!TP_Risk_SessionOK(TimeCurrent(), true)) return;
   if(!TP_Risk_SpreadOK()) return;
   if(!TP_Risk_MarginLevelOK()) return;
   if(g_tp.atr5 <= 0.0 || g_tp.atrM15 <= 0.0) return;

   int regime = g_tp.regime;
   bool onlyBuy = false;
   bool onlySell = false;

   if(TP_UseRegime())
     {
      if(regime == TP_REG_CHAOS) return;
      if(TP_IsOneSide())
        {
         if(regime != TP_REG_TREND_UP && regime != TP_REG_TREND_DOWN) return;
         onlyBuy  = (regime == TP_REG_TREND_UP);
         onlySell = (regime == TP_REG_TREND_DOWN);
        }
      else if(!TP_IsPureIdea())
        {
         if(regime != TP_REG_RANGE) return;
        }
     }

   //--- the price must be close to the Bollinger middle line ---------
   double mid = g_tp.regimeBbMid;
   if(mid > 0.0)
     {
      MqlTick tick;
      if(!SymbolInfoTick(g_symbol, tick)) return;
      double price = (tick.ask + tick.bid) * 0.5;
      double maxDist = BBRangeATR * g_tp.atrM15;
      if(MathAbs(price - mid) > maxDist) return;
     }

   //--- start the cycle ------------------------------------------------
   g_tp.cycleId++;
   if(g_tp.cycleId < 1) g_tp.cycleId = 1;
   g_tp.cycleStart   = TimeCurrent();
   g_tp.cycleRegime  = regime;
   g_tp.bank         = 0.0;
   g_tp.cycleRealized= 0.0;
   g_tp.cycleShredded= 0.0;
   g_tp.closedLegs   = 0;
   g_tp.openedLegs   = 0;
   g_tp.lastReopen   = TimeCurrent();

   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      g_tp.legs[i].used       = false;
      g_tp.legs[i].generation = 0;
      g_tp.legs[i].beDone     = false;
      g_tp.legs[i].realized   = 0.0;
      g_tp.legs[i].peakPrice  = 0.0;
     }

   int opened = 0;
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(onlyBuy  && !TP_LegIsBuy(i))  continue;
      if(onlySell && TP_LegIsBuy(i))   continue;
      if(TP_Legs_OpenOne(i, false)) opened++;
     }

   TP_State_SyncPositions();
   TP_State_Save();

   if(opened == 0)
     {
      TP_LogWarn("Cycle start aborted, no leg could be opened.");
      g_tp.cycleId--;
      return;
     }

   TP_LogInfo(StringFormat("Cycle %d started: %d legs, regime %s, ATR5 %.3f, spread %.3f",
                           g_tp.cycleId, opened, TP_RegimeName(regime),
                           g_tp.atr5, TP_Exec_CurrentSpreadPrice()));
  }

//+------------------------------------------------------------------+
//| TP_Legs_TryRebalance - re-open the legs that are missing           |
//+------------------------------------------------------------------+
void TP_Legs_TryRebalance(void)
  {
   if(TP_State_OpenLegCount() == 0) return;

   int openBuy  = TP_State_CountOpenLegs(TP_SIDE_BUY);
   int openSell = TP_State_CountOpenLegs(TP_SIDE_SELL);
   int wanted   = g_legsPerSide;

   bool sideMissing = (openBuy < wanted) || (openSell < wanted);
   if(!sideMissing) return;

   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(g_tp.legs[i].open) continue;
      if(!g_tp.legs[i].used) continue;         // never opened in this cycle

      string reason = "";
      if(!TP_Legs_ReopenAllowed(i, reason))
        {
         TP_LogInfo(StringFormat("%s not re-opened: %s", TP_LegName(i), reason));
         continue;
        }

      TP_LogInfo(StringFormat("%s is re-opened to balance the cycle.", TP_LegName(i)));
      TP_Legs_OpenOne(i, true);
      TP_State_SyncPositions();
     }
  }

//+------------------------------------------------------------------+
//| TP_Legs_CloseCycle - close every leg of the running cycle          |
//+------------------------------------------------------------------+
void TP_Legs_CloseCycle(const string reason)
  {
   int openCount = TP_State_OpenLegCount();
   if(openCount == 0)
     {
      g_tp.bank = 0.0;
      g_tp.cycleRealized = 0.0;
      return;
     }

   TP_LogInfo(StringFormat("Closing the cycle %d (%d legs), reason: %s",
                           g_tp.cycleId, openCount, reason));

   //--- first close the pairs with Close By ---------------------------
   for(int slot = 0; slot < TP_SLOT_COUNT; slot++)
     {
      int buyLeg  = (slot == 0) ? TP_LEG_BUY_A  : TP_LEG_BUY_B;
      int sellLeg = (slot == 0) ? TP_LEG_SELL_A : TP_LEG_SELL_B;
      if(!g_tp.legs[buyLeg].open || !g_tp.legs[sellLeg].open) continue;
      if(MathAbs(g_tp.legs[buyLeg].volume - g_tp.legs[sellLeg].volume) > 1e-8) continue;

      if(TP_Exec_CloseBy(g_tp.legs[buyLeg].ticket, g_tp.legs[sellLeg].ticket))
        {
         TP_Legs_RegisterClose(buyLeg,  "cycle_closeby", 0.0);
         TP_Legs_RegisterClose(sellLeg, "cycle_closeby", 0.0);
        }
     }

   //--- then close whatever is left -----------------------------------
   for(int i = 0; i < TP_LEG_COUNT; i++)
     {
      if(!g_tp.legs[i].open) continue;
      if(TP_Exec_CloseLeg(g_tp.legs[i].ticket))
         TP_Legs_RegisterClose(i, "cycle_close", 0.0);
     }

   TP_State_SyncPositions();

   TP_LogCycleCSV(g_tp.cycleId, g_tp.cycleStart, TimeCurrent(), TP_RegimeName(g_tp.cycleRegime),
                  g_tp.openedLegs, g_tp.closedLegs, g_tp.cycleRealized, g_tp.bank,
                  g_tp.cycleShredded, reason, TP_Exec_CurrentSpreadPrice(), g_tp.atr5);

   g_tp.bank          = 0.0;
   g_tp.cycleRealized = 0.0;
   g_tp.cycleShredded = 0.0;
   g_tp.openedLegs    = 0;
   g_tp.closedLegs    = 0;
   TP_State_Save();
  }

#endif // TP_LEGS_MQH
//+--- end MQL5/Include/TwinPulse/Legs.mqh -----------------------------
//+--- begin MQL5/Include/TwinPulse/Panel.mqh ----------------------------
//+------------------------------------------------------------------+
//|                                                  Panel.mqh        |
//|  TwinPulse Hedge EA                                                 |
//|  On chart panel with the state of the EA, the legs and the brakes. |
//+------------------------------------------------------------------+
#ifndef TP_PANEL_MQH
#define TP_PANEL_MQH

// (already inlined) project header: Config.mqh
// (already inlined) project header: Utils.mqh
// (already inlined) project header: Logger.mqh
// (already inlined) project header: State.mqh
// (already inlined) project header: Execution.mqh
// (already inlined) project header: Risk.mqh
// (already inlined) project header: Regime.mqh
// (already inlined) project header: News.mqh

#define TP_PANEL_BG   TP_PANEL_PREFIX + "BG"
#define TP_PANEL_TXT  TP_PANEL_PREFIX + "TXT"

//+------------------------------------------------------------------+
//| TP_Panel_Init - create the panel objects                           |
//+------------------------------------------------------------------+
void TP_Panel_Init(void)
  {
   if(!ShowPanel) return;

   if(ObjectFind(0, TP_PANEL_BG) < 0)
      ObjectCreate(0, TP_PANEL_BG, OBJ_RECTANGLE_LABEL, 0, 0, 0);
   if(ObjectFind(0, TP_PANEL_TXT) < 0)
      ObjectCreate(0, TP_PANEL_TXT, OBJ_LABEL, 0, 0, 0);

   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_XDISTANCE, 8);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_YDISTANCE, 8);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_BGCOLOR, clrBlack);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_WIDTH, 1);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_BACK, false);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_ZORDER, 0);

   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_XDISTANCE, 14);
   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_YDISTANCE, 12);
   ObjectSetString(0, TP_PANEL_TXT, OBJPROP_FONT, "Consolas");
   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_FONTSIZE, PanelFontSize);
   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_COLOR, clrSilver);
   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_ZORDER, 1);
  }

//+------------------------------------------------------------------+
//| TP_Panel_Release - remove the panel objects                        |
//+------------------------------------------------------------------+
void TP_Panel_Release(void)
  {
   ObjectDelete(0, TP_PANEL_BG);
   ObjectDelete(0, TP_PANEL_TXT);
   ChartRedraw(0);
  }

//+------------------------------------------------------------------+
//| TP_Panel_LegLine - one line per leg                                 |
//+------------------------------------------------------------------+
string TP_Panel_LegLine(const int legIndex)
  {
   if(!g_tp.legs[legIndex].open)
      return StringFormat("  %-7s   --   closed", TP_LegName(legIndex));

   return StringFormat("  %-7s %+7.2f  %0.2f lots  gen %d",
                       TP_LegName(legIndex),
                       g_tp.legs[legIndex].profit,
                       g_tp.legs[legIndex].volume,
                       g_tp.legs[legIndex].generation);
  }

//+------------------------------------------------------------------+
//| TP_Panel_Update - redraw the panel                                 |
//+------------------------------------------------------------------+
void TP_Panel_Update(void)
  {
   if(!ShowPanel) return;

   double equity   = AccountInfoDouble(ACCOUNT_EQUITY);
   double balance  = AccountInfoDouble(ACCOUNT_BALANCE);
   double margin   = AccountInfoDouble(ACCOUNT_MARGIN);
   double free     = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   double mlevel   = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
   double spread   = TP_Exec_CurrentSpreadPrice();
   double maxSpread= TP_Risk_MaxSpreadPrice();
   double daily    = equity - g_tp.dayStartEquity;

   string modeName = "FULL";
   if(TP_IsPureIdea()) modeName = "PURE_IDEA";
   if(TP_IsOneSide())  modeName = "ONE_SIDE";

   string brakeText = "OK";
   if(g_tp.dailyLocked)  brakeText = "DAILY STOP";
   if(g_tp.basketLocked) brakeText = "BASKET STOP";
   if(!g_tp.tradeAllowed) brakeText = "NO TRADING";

   int cooldown = 0;
   if(g_tp.lastReopen > 0)
     {
      int left = ReopenCooldownSec - (int)(TimeCurrent() - g_tp.lastReopen);
      if(left > 0) cooldown = left;
     }

   string text = "";
   text += StringFormat("%s %s | %s | cycle %d\n", TP_NAME, TP_VER, modeName, g_tp.cycleId);
   text += StringFormat("%s  magic %d  %s\n", g_symbol, (int)g_magic,
                        TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS));
   text += StringFormat("regime %-9s spread %.3f/%.3f  ATR5 %.3f  ATR15 %.3f\n",
                        TP_RegimeName(g_tp.regime), spread, maxSpread, g_tp.atr5, g_tp.atrM15);
   text += "legs\n";
   for(int i = 0; i < TP_LEG_COUNT; i++)
      text += TP_Panel_LegLine(i) + "\n";
   text += StringFormat("floating %+.2f  realized %+.2f  bank %.2f  shredded %.2f\n",
                        TP_State_AllFloating(), g_tp.cycleRealized, g_tp.bank, g_tp.cycleShredded);
   text += StringFormat("daily %+.2f  equity %.2f  balance %.2f\n", daily, equity, balance);
   text += StringFormat("brakes %-10s margin %.0f%% free %.2f\n", brakeText, mlevel, free);
   text += StringFormat("swaps ~%.2f/night (%s)  news %s  cooldown %ds\n",
                        TP_Risk_SwapEstimate(), TP_Risk_SwapModeText(),
                        TP_News_Status(), cooldown);
   if(!g_tp.tradeAllowed)
      text += StringFormat("!! %s\n", g_tp.blockReason);

   ObjectSetString(0, TP_PANEL_TXT, OBJPROP_TEXT, text);

   int lines = 12;
   int width = 470;
   int height = lines * (PanelFontSize + 3) + 10;

   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_XSIZE, width);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_YSIZE, height);
   ObjectSetInteger(0, TP_PANEL_BG, OBJPROP_BGCOLOR,
                    g_tp.tradeAllowed ? clrBlack : clrMaroon);
   ObjectSetInteger(0, TP_PANEL_TXT, OBJPROP_COLOR,
                    g_tp.tradeAllowed ? clrSilver : clrWhite);

   ChartRedraw(0);
  }

#endif // TP_PANEL_MQH
//+--- end MQL5/Include/TwinPulse/Panel.mqh ----------------------------

//--- bar trackers -----------------------------------------------------
datetime g_lastM5Bar  = 0;
datetime g_lastM15Bar = 0;
datetime g_lastSyncSec = 0;
bool     g_initialised = false;

//+------------------------------------------------------------------+
//| OnInit - validate the environment and build the runtime state      |
//+------------------------------------------------------------------+
int OnInit()
  {
   g_symbol = _Symbol;
   g_magic  = Magic;
   g_legsPerSide = LegsPerSide;

   if(!SymbolSelect(g_symbol, true))
     {
      Print("TwinPulse: cannot select ", g_symbol);
      return INIT_FAILED;
     }

   g_point  = SymbolInfoDouble(g_symbol, SYMBOL_POINT);
   g_digits = (int)SymbolInfoInteger(g_symbol, SYMBOL_DIGITS);
   if(g_point <= 0.0 || g_digits <= 0)
     {
      Print("TwinPulse: invalid symbol properties for ", g_symbol);
      return INIT_FAILED;
     }

   //--- the martingale escalation needs an explicit confirmation -----
   if(LotMultiplier > 1.0 && !IUnderstandMartingaleRisk)
     {
      Print("TwinPulse: LotMultiplier > 1.0 needs IUnderstandMartingaleRisk = true, the multiplier is reset to 1.0.");
      }

   if(g_legsPerSide < 1) g_legsPerSide = 1;
   if(g_legsPerSide > 2) g_legsPerSide = 2;

   //--- trade objects -------------------------------------------------
   g_trade.SetExpertMagicNumber((ulong)g_magic);
   g_trade.SetDeviationInPoints(DeviationPoints);
   g_trade.SetTypeFillingBySymbol(g_symbol);
   g_trade.SetAsyncMode(false);

   //--- state ---------------------------------------------------------
   TP_State_Init();
   TP_State_Load();

   //--- the environment checks decide if we may trade -----------------
   g_tp.tradeAllowed = true;
   g_tp.blockReason  = "";

   long marginMode = AccountInfoInteger(ACCOUNT_MARGIN_MODE);
   if(marginMode != ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
     {
      g_tp.tradeAllowed = false;
      g_tp.blockReason  = "This is not a hedging account (ACCOUNT_MARGIN_MODE), the EA does not trade.";
     }

   if(AccountInfoInteger(ACCOUNT_TRADE_MODE) == ACCOUNT_TRADE_MODE_REAL && !AllowLive)
     {
      g_tp.tradeAllowed = false;
      g_tp.blockReason  = "Real account and AllowLive = false, the EA does not trade.";
     }

   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))
     {
      g_tp.tradeAllowed = false;
      g_tp.blockReason  = "Algo Trading is disabled in the terminal.";
     }

   if(!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED))
     {
      g_tp.tradeAllowed = false;
      g_tp.blockReason  = "Trading is not allowed for this account.";
     }

   if(!AccountInfoInteger(ACCOUNT_TRADE_EXPERT))
     {
      g_tp.tradeAllowed = false;
      g_tp.blockReason  = "Trading with expert advisors is not allowed for this account.";
     }

   int tradeMode = (int)SymbolInfoInteger(g_symbol, SYMBOL_TRADE_MODE);
   if(tradeMode == SYMBOL_TRADE_MODE_DISABLED || tradeMode == SYMBOL_TRADE_MODE_CLOSEONLY)
     {
      g_tp.tradeAllowed = false;
      g_tp.blockReason  = StringFormat("%s is not open for trading (SYMBOL_TRADE_MODE = %d).", g_symbol, tradeMode);
     }

   //--- indicators ----------------------------------------------------
   if(!TP_Regime_Init())
      return INIT_FAILED;

   //--- news ----------------------------------------------------------
   TP_News_Init();

   //--- spread statistics ---------------------------------------------
   TP_Risk_InitSpreadSamples();

   //--- rebuild the state from the open positions ---------------------
   TP_State_SyncPositions();
   for(int i = 0; i < TP_LEG_COUNT; i++)
      g_tp.legs[i].wasOpen = g_tp.legs[i].open;

   if(TP_State_OpenLegCount() > 0)
     {
      TP_LogInfo(StringFormat("Restart: %d open legs found, cycle %d.",
                              TP_State_OpenLegCount(), g_tp.cycleId));
      TP_State_Save();
     }

   //--- panel and timer ------------------------------------------------
   TP_Panel_Init();
   TP_Panel_Update();

   if(!EventSetTimer(TimerSeconds))
     {
      TP_LogError("EventSetTimer failed, the EA will not manage the cycle.");
      return INIT_FAILED;
     }

   g_lastM5Bar  = iTime(g_symbol, PERIOD_M5, 0);
   g_lastM15Bar = iTime(g_symbol, PERIOD_M15, 0);
   TP_Regime_Update();

   TP_LogInfo(StringFormat("%s %s started on %s, magic %d, mode %d, lot %.2f, %s",
                           TP_NAME, TP_VER, g_symbol, (int)g_magic, (int)Mode,
                           BaseLot, g_tp.tradeAllowed ? "trading enabled" : g_tp.blockReason));

   g_initialised = true;
   return INIT_SUCCEEDED;
  }

//+------------------------------------------------------------------+
//| OnDeinit - clean up                                               |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   EventKillTimer();
   TP_State_Save();
   TP_Regime_Release();
   TP_Panel_Release();
   TP_LogInfo(StringFormat("TwinPulse stopped, reason %d.", reason));
  }

//+------------------------------------------------------------------+
//| OnTick - fast path: exits, trailing, brakes                        |
//+------------------------------------------------------------------+
void OnTick()
  {
   if(!g_initialised) return;
   if(!g_tp.tradeAllowed) return;

   //--- the position scan is throttled to one second, the timer does a
   //    full synchronisation every second anyway -----------------------
   if(TimeCurrent() != g_lastSyncSec)
     {
      g_lastSyncSec = TimeCurrent();
      TP_State_SyncPositions();
     }
   TP_Legs_DetectClosedLegs();

   //--- exits and trailing --------------------------------------------
   TP_Legs_Update();

   //--- basket target --------------------------------------------------
   double totalVolume = TP_State_TotalVolume();
   if(totalVolume > 0.0)
     {
      double target = TP_ScaledUSD(CycleTargetUSD, totalVolume);
      if(target > 0.0 && TP_State_CycleTotal() >= target)
        {
         TP_LogInfo(StringFormat("Basket target reached: cycle total %.2f >= %.2f.",
                                 TP_State_CycleTotal(), target));
         TP_Legs_CloseCycle("basket target");
        }
     }

   //--- brakes ----------------------------------------------------------
   if(!g_tp.basketLocked && TP_Risk_BasketStopHit())
     {
      TP_Legs_CloseCycle("basket stop");
      g_tp.basketLocked = true;
      TP_State_Save();
      TP_LogError(StringFormat("Basket stop triggered (%.2f%% of equity), no new cycle until the next server day.",
                               BasketStopPct));
     }

   if(!g_tp.dailyLocked && TP_Risk_DailyStopHit())
     {
      TP_Legs_CloseCycle("daily loss stop");
      g_tp.dailyLocked = true;
      TP_State_Save();
      TP_LogError(StringFormat("Daily loss stop triggered (%.2f%% of the start of day equity), trading pauses until the next server day.",
                               DailyStopPct));
     }
  }

//+------------------------------------------------------------------+
//| OnTimer - slow path: regime, starts, re-balance, shredding        |
//+------------------------------------------------------------------+
void OnTimer()
  {
   if(!g_initialised) return;

   TP_Risk_UpdateSpreadSample();
   TP_Risk_UpdateDayEquity();
   TP_News_Update();

   datetime now = TimeCurrent();

   //--- new M5 bar: refresh the ATR ------------------------------------
   datetime barM5 = iTime(g_symbol, PERIOD_M5, 0);
   if(barM5 != g_lastM5Bar)
     {
      g_lastM5Bar = barM5;
      TP_Regime_UpdateAtr();
     }

   //--- new M15 bar: full regime detection -----------------------------
   datetime barM15 = iTime(g_symbol, PERIOD_M15, 0);
   if(barM15 != g_lastM15Bar)
     {
      g_lastM15Bar = barM15;
      TP_Regime_Update();
     }

   if(!g_tp.tradeAllowed)
     {
      TP_Panel_Update();
      return;
     }

   TP_State_SyncPositions();
   TP_Legs_DetectClosedLegs();

   //--- new cycle or re-balance ----------------------------------------
   if(TP_State_OpenLegCount() == 0)
     {
      TP_Legs_TryStartCycle();
     }
   else
     {
      TP_Legs_TryRebalance();
      TP_Bank_TryShred();
     }

   //--- flatten before the weekend --------------------------------------
   if(FlattenBeforeWeekend && TP_IsFriday(now))
     {
      int hour   = TP_ServerHour(now);
      int minute = TP_ServerMinute(now);
      if((hour > FridayFlattenHour) || (hour == FridayFlattenHour && minute >= FridayFlattenMinute))
        {
         if(TP_State_OpenLegCount() > 0)
           {
            TP_LogInfo("Friday flatten: closing every open leg.");
            TP_Legs_CloseCycle("friday flatten");
           }
        }
     }

   TP_Panel_Update();
  }

//+------------------------------------------------------------------+
//| OnTradeTransaction - keep the state in sync with the server        |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &trans,
                        const MqlTradeRequest &request,
                        const MqlTradeResult &result)
  {
   if(!g_initialised) return;
   if(trans.symbol != g_symbol) return;

   if(trans.type == TRADE_TRANSACTION_DEAL_ADD)
     {
      if(trans.deal == 0 || !HistoryDealSelect(trans.deal)) return;
      long dealMagic = HistoryDealGetInteger(trans.deal, DEAL_MAGIC);
      if(dealMagic != g_magic) return;

      TP_LogInfo(StringFormat("Deal: order %I64u, deal %I64u, type %d, volume %.2f @ %s",
                              trans.order, trans.deal, (int)trans.type,
                              result.volume, TP_Str(result.price, g_digits)));
     }
   else if(trans.type == TRADE_TRANSACTION_POSITION)
     {
      if(trans.position == 0 || !PositionSelectByTicket(trans.position)) return;
      long positionMagic = PositionGetInteger(POSITION_MAGIC);
      if(positionMagic != g_magic) return;
     }
   else
      return;

   TP_State_SyncPositions();
  }

//+------------------------------------------------------------------+
//| OnTester - the custom optimisation criterion                        |
//+------------------------------------------------------------------+
double OnTester()
  {
   double trades = TesterStatistics(STAT_TRADES);
   double pf     = TesterStatistics(STAT_PROFIT_FACTOR);
   double rf     = TesterStatistics(STAT_RECOVERY_FACTOR);
   double dd     = TesterStatistics(STAT_EQUITY_DDREL_PERCENT);

   if(trades < 200.0 || dd > 25.0)
      return 0.0;

   if(pf > 3.0) pf = 3.0;
   if(pf < 0.0) pf = 0.0;
   if(rf < 0.0) rf = 0.0;

   return rf * pf * MathSqrt(trades / 100.0);
  }
