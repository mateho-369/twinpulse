; ==========================================================================
;  TwinPulse Reversal - the owner's rule, R4_Ladder
;  R1 plus the 30/60/90% profit lock, at 0.03 lot
; 0.03 lot because a third of 0.01 is 0.0033, below the broker minimum:
; the ladder needs three real 0.01 steps. Judge it against R7 (same lot,
; no ladder), never against R1 (0.01 lot).
;  Identical lots on both sides, no martingale, no averaging. The guard is
;  the ONLY thing that limits the orphan leg: with InpGuard_ATR=0 the EA
;  holds a naked position until the price returns, however long that takes.
;  Run:  powershell -File tools\run_batch.ps1 -Preset tester\reversal
;        -Expert TwinPulse\TwinPulseReversal -Period H1 -Model 1
; ==========================================================================

InpMagic=26101703
InpComment=TPR
InpLots=0.03
InpMaxLots=1.00
InpTarget_ATR=3.00
InpTargetPoints=0.00
InpLockLadder=true
InpGuard_ATR=15.00
InpATRPeriod=14
InpWinnerStop_ATR=0.00
InpMaxSpread=0.60
InpMaxDrawdownPct=25.00
InpMaxHoldHours=0
InpWriteCsv=true
InpVerboseLog=true
