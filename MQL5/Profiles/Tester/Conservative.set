; ==========================================================================
;  TwinPulse Hedge EA - Conservative.set
;  Smaller targets are NOT used here, the stop is tighter, the brakes are
;  tighter and the trading window is narrower.  Mode 0 = TP_FULL.
; ==========================================================================

;--- general ---------------------------------------------------------------
Magic=26101701
Mode=0
AllowLive=false
ShowPanel=true
EnableFileLog=true
VerboseLog=false
TimerSeconds=1
DeviationPoints=30
MaxOrderRetries=3

;--- legs and sizing -------------------------------------------------------
LegsPerSide=2
BaseLot=0.01
LotMultiplier=1.0
IUnderstandMartingaleRisk=false
RiskMode=0
LegRiskPct=0.5
MaxTotalLots=0.08

;--- targets and exits -----------------------------------------------------
TargetA_ATR=0.8
TargetB_ATR=2.0
BE_ATR=0.5
Trail_ATR=0.6
HardSL_ATR=2.0
CostFloorSpreadMult=3.0
CycleTargetUSD=3.0
MinBankUSD=0.40
RebalanceTolUSD=0.08
ShredStepLot=0.01
MaxLoserMinutes=120

;--- regime ----------------------------------------------------------------
RegimeERPeriod=20
ErRange=0.30
ErTrend=0.40
ChopRange=58.0
AdxRange=20.0
AdxTrend=30.0
AtrSpikeRatio=1.8
SlopeBars=10
BBPeriod=20
BBDev=2.0
BBRangeATR=0.4

;--- brakes ----------------------------------------------------------------
BasketStopPct=6.0
DailyStopPct=3.0
MinMarginLevelPct=400.0
MaxSpreadPrice=0.45
SpreadMedianMult=1.8
SpreadSampleSec=5
SpreadWindowMin=20

;--- sessions --------------------------------------------------------------
SessionStartHour=1
SessionEndHour=20
RolloverStartHour=21
RolloverEndHour=24
FridayStopHour=19
FridayFlattenHour=20
FridayFlattenMinute=45
FlattenBeforeWeekend=true
ReopenCooldownSec=120

;--- news ------------------------------------------------------------------
UseNewsFilter=true
NewsMinutesBefore=20
NewsMinutesAfter=20
NewsCsvFile=TwinPulse_news.csv
ServerUTCOffsetHours=0.0

;--- display ---------------------------------------------------------------
PanelFontSize=9
WriteCsvLogs=true
FeePerLotRoundTurn=0.0
