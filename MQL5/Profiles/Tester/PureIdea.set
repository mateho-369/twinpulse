; ==========================================================================
;  TwinPulse Hedge EA - PureIdea.set
;  Mode 1 = TP_PURE_IDEA : the owner rule only.
;  4 legs, close the winner, re-open at break even, no regime filter,
;  no bank and no shredding.  All brakes stay switched on.
; ==========================================================================

;--- general ---------------------------------------------------------------
Magic=26101701
Mode=1
AllowLive=false
ShowPanel=true
EnableFileLog=true
VerboseLog=false
TimerSeconds=1
DeviationPoints=30
MaxOrderRetries=3

;--- legs and sizing -------------------------------------------------------
LegsPerSide=2
BaseLot=0.01
LotMultiplier=1.0
IUnderstandMartingaleRisk=false
RiskMode=0
LegRiskPct=0.5
MaxTotalLots=0.08

;--- targets and exits -----------------------------------------------------
TargetA_ATR=0.6
TargetB_ATR=1.5
BE_ATR=0.6
Trail_ATR=0.8
HardSL_ATR=2.5
CostFloorSpreadMult=3.0
CycleTargetUSD=2.0
MinBankUSD=0.30
RebalanceTolUSD=0.10
ShredStepLot=0.01
MaxLoserMinutes=240

;--- regime (ignored in PURE_IDEA, kept for the panel) ---------------------
RegimeERPeriod=20
ErRange=0.30
ErTrend=0.40
ChopRange=55.0
AdxRange=22.0
AdxTrend=28.0
AtrSpikeRatio=2.0
SlopeBars=10
BBPeriod=20
BBDev=2.0
BBRangeATR=0.5

;--- brakes ----------------------------------------------------------------
BasketStopPct=10.0
DailyStopPct=5.0
MinMarginLevelPct=300.0
MaxSpreadPrice=0.60
SpreadMedianMult=2.0
SpreadSampleSec=5
SpreadWindowMin=20

;--- sessions --------------------------------------------------------------
SessionStartHour=0
SessionEndHour=21
RolloverStartHour=21
RolloverEndHour=24
FridayStopHour=20
FridayFlattenHour=20
FridayFlattenMinute=45
FlattenBeforeWeekend=true
ReopenCooldownSec=60

;--- news ------------------------------------------------------------------
UseNewsFilter=true
NewsMinutesBefore=15
NewsMinutesAfter=15
NewsCsvFile=TwinPulse_news.csv
ServerUTCOffsetHours=0.0

;--- display ---------------------------------------------------------------
PanelFontSize=9
WriteCsvLogs=true
FeePerLotRoundTurn=0.0
